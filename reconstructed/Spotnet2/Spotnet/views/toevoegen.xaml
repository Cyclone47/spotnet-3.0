<UserControl x:Class="Spotnet.Views.Toevoegen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:views="clr-namespace:Spotnet.Views">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True" Height="{Binding Path=ActualHeight, ElementName=container}" Width="{Binding Path=ActualWidth, ElementName=container}">
    <Grid Height="Auto">
      <Grid Margin="23,698,10,10" Width="762" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Margin="0,5,10,0" Content="{x:Static p:Words.Website}" />
        <CheckBox Name="WebsiteCheckBox" Grid.Column="1" Grid.Row="0" Margin="0,5,0,0" Checked="WebsiteCheckBox_OnChecked" Unchecked="WebsiteCheckBox_OnUnchecked" />
        <TextBox Name="WebsiteTextBox" Grid.Column="2" Grid.Row="0" Margin="0,5,10,0" VerticalContentAlignment="Center" TabIndex="7" IsEnabled="False" ToolTip="{x:Static p:Words.WebsiteOfTheSpot}" />
        <Label Grid.Column="0" Grid.Row="1" Content="{x:Static p:Words.Picture}" Margin="0,5,10,0" />
        <TextBox Name="ImageTextBox" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" Margin="0,5,10,0" TabIndex="8" ToolTip="{x:Static p:Words.LinkToSpotPicture}" TextChanged="ImageTextBox_OnTextChanged" />
        <Button Name="ImageBrowseButton" Grid.Column="3" Grid.Row="1" Margin="10,5,0,0" Content="{x:Static p:Words.Browse}" IsDefault="False" Width="90" TabIndex="9" Click="ImageBrowseButton_Click" />
        <Label Grid.Column="0" Grid.Row="2" Margin="0,5,10,0" Content="NZB" />
        <DockPanel Grid.Column="2" Grid.Row="2" Margin="0,5,10,0">
          <Button Name="DummyNzbButton" DockPanel.Dock="Right" Content="{x:Static p:Words.GenerateDummyNzb}" Margin="5,0,0,0" TabIndex="11" Click="DummyNzbButton_OnClick" />
          <TextBox Name="NzbTextBox" TabIndex="10" VerticalContentAlignment="Center" ToolTip="{x:Static p:Words.NZBFileSelect}" />
        </DockPanel>
        <Button Name="NzbPathBrowseButton" Margin="10,5,0,0" Grid.Column="3" Grid.Row="2" Content="{x:Static p:Words.Browse}" IsDefault="False" TabIndex="12" Click="NzbPathBrowseButton_Click" />
        <Label Grid.Column="0" Grid.Row="3" Content="{x:Static p:Words.EncryptedNZB}" Margin="0,5,20,0" />
        <CheckBox Name="EncryptedNzbCheckBox" Grid.Column="1" Grid.Row="3" Margin="0,5,0,0" Checked="EncryptedNzbCheckBox_OnChecked" Unchecked="EncryptedNzbCheckBox_OnUnchecked" />
        <TextBox Name="EncryptedNzbTextBox" TabIndex="13" Grid.Column="2" Grid.Row="3" VerticalContentAlignment="Center" IsEnabled="False" Margin="0,5,10,0" ToolTip="{x:Static p:Words.NZBFileSelect}" />
        <Button Name="EncryptedNzbBrowseButton" Grid.Column="3" Grid.Row="3" IsEnabled="False" Content="{x:Static p:Words.Browse}" IsDefault="False" Margin="10,5,0,0" TabIndex="14" Click="EncryptedNzbBrowseButton_Click" />
        <Label Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Center" Content="{x:Static p:Words.EncryptedNZBTooltip}" Margin="0,-3,10,0" Foreground="{DynamicResource ErrorForegroundBrush}" FontStyle="Italic" FontSize="{DynamicResource ContentFontSize}" />
        <Grid Column="2" Row="5" Margin="0,5,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,5,0">
            <Label Content="{x:Static p:Words.Sender}" DockPanel.Dock="Left" />
            <TextBox Name="PosterTextBox" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" TabIndex="12" ToolTip="{x:Static p:Words.EnterYourNameHere}" TextChanged="PosterTextBox_TextChanged" PreviewTextInput="PosterTextBox_PreviewTextInput" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="5,0,0,0">
            <Label Content="Tag" />
            <TextBox Name="TagTextBox" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" TabIndex="13" ToolTip="{x:Static p:Words.EnterTag}" TextChanged="TagTextBox_TextChanged" PreviewTextInput="TagTextBox_PreviewTextInput" />
          </StackPanel>
        </Grid>
        <DockPanel Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="4" Margin="0,25,0,20">
          <Button Name="PostButton" Content="{x:Static p:Words.PostNewSpot}" Width="130" Height="35" DockPanel.Dock="Right" Margin="20,0,0,0" Background="{StaticResource AccentColor3BackgroundBrush}" IsDefault="False" TabIndex="15" Click="PostButton_Click" />
          <Button Name="PreviewButton" Content="{x:Static p:Words.Preview}" Width="130" Height="35" DockPanel.Dock="Right" HorizontalAlignment="Right" IsDefault="True" TabIndex="14" Click="PreviewButton_Click" />
        </DockPanel>
      </Grid>
      <ListBox Name="Cat1" Height="233" HorizontalAlignment="Left" Margin="28,431,0,0" VerticalAlignment="Top" Width="203" IsEnabled="False" TabIndex="4">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ListBox>
      <ListBox Name="Cat2" Height="232" HorizontalAlignment="Left" Margin="252,431,0,0" VerticalAlignment="Top" Width="203" IsEnabled="False" TabIndex="5">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ListBox>
      <ListBox Name="Cat3" Height="233" HorizontalAlignment="Left" Margin="481,431,0,0" VerticalAlignment="Top" Width="194" IsEnabled="False" TabIndex="6">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ListBox>
      <Label Name="CatLab1" Content="{x:Static p:Categories.Source}" FontWeight="Normal" Height="32" HorizontalAlignment="Left" Margin="25,392,0,0" VerticalAlignment="Top" Width="107" Visibility="Visible" />
      <Label Name="CatLab2" Content="{x:Static p:Categories.Language}" FontWeight="Normal" Height="32" Margin="252,392,0,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Left" Width="107" />
      <Label Name="CatLab3" Content="{x:Static p:Words.ColumnGenre}" FontWeight="Normal" Height="32" HorizontalAlignment="Left" Margin="478,392,0,0" VerticalAlignment="Top" Width="107" Visibility="Visible" />
      <Label Content="{x:Static p:Words.ColumnSubject}" FontWeight="Normal" Height="40" HorizontalAlignment="Left" Margin="22,56,0,0" VerticalAlignment="Top" Width="107" />
      <Label Content="{x:Static p:Words.Description}" FontWeight="Normal" Height="32" HorizontalAlignment="Left" Margin="22,94,0,0" VerticalAlignment="Top" Width="107" />
      <Label Content="{x:Static p:Categories.Type}" FontWeight="Normal" Height="32" HorizontalAlignment="Left" Margin="22,18,0,0" VerticalAlignment="Top" VerticalContentAlignment="Top" Width="107" />
      <ComboBox Name="CatBox" Height="24" IsReadOnly="True" Margin="151,21,0,0" TabIndex="0" VerticalAlignment="Top" ToolTip="{x:Static p:Categories.CatMain}" HorizontalAlignment="Left" Width="96" SelectionChanged="CatBox_SelectionChanged">
        <ComboBoxItem Content="{x:Static p:Words.Video}" Tag="1" />
        <ComboBoxItem Content="{x:Static p:Words.Sound}" Tag="2" />
        <ComboBoxItem Content="{x:Static p:Words.Game}" Tag="3" />
        <ComboBoxItem Content="{x:Static p:Words.Application}" Tag="4" />
      </ComboBox>
      <TextBox Name="TitelTextBox" Height="23" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="151,60,0,0" MaxLength="150" TabIndex="2" VerticalAlignment="Top" Width="524" ToolTip="{x:Static p:Words.EnterNameOfSpot}" TextChanged="TitelTextBox_OnTextChanged" />
      <TextBox Name="DescTextBox" AcceptsReturn="True" Height="238" HorizontalAlignment="Left" Margin="28,132,0,0" TabIndex="3" TextWrapping="Wrap" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" Width="647" ToolTip="{x:Static p:Words.SpotGiveDescription}" />
      <Image Name="ImagePreview" Stretch="Uniform" Margin="701,431,0,0" Width="400" Height="233" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <ComboBox Name="SCatBox" Height="24" IsEnabled="False" IsReadOnly="True" Margin="541,21,0,0" TabIndex="1" VerticalAlignment="Top" HorizontalAlignment="Left" Width="134" />
      <Label Name="Label1" Content="{x:Static p:Words.ColumnFormat}" FontWeight="Normal" Height="32" Margin="482,18,0,0" VerticalAlignment="Top" ToolTip="{x:Static p:Categories.SubCategory}" HorizontalAlignment="Left" Width="67" />
      <Label Name="Label10" Content="{x:Static p:Categories.Category}" FontWeight="Normal" Height="32" Margin="278,18,0,0" VerticalAlignment="Top" VerticalContentAlignment="Top" HorizontalAlignment="Left" Width="81" />
      <ComboBox Name="Cat2Box" Height="24" IsReadOnly="True" Margin="345,21,0,0" TabIndex="0" ToolTip="{x:Static p:Categories.CatMain}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="112" IsEnabled="False" SelectionChanged="Cat2Box_SelectionChanged" />
    </Grid>
  </ScrollViewer>
</UserControl>