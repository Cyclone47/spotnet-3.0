<UserControl x:Class="Spotnet.Controls.SettingsForDatabase" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Orientation="Vertical">
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <CheckBox Name="RetentionCheckBox" Content="{x:Static p:Words.Retention}" Click="RetentionCheckBox_OnClick" />
      <Border Name="RetentionTextBoxBorder" BorderBrush="#00FFFFFF" HorizontalAlignment="Left" Margin="25,0" BorderThickness="2">
        <TextBox Name="RetentionTextBox" TabIndex="2" ToolTip="{x:Static p:Words.Retention}" Width="50" GotFocus="Retention_GotFocus" TextChanged="RetentionTextBox_OnTextChanged" />
      </Border>
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <TextBlock Text="{x:Static p:Words.InitialFetchRange}" />
      <ComboBox Name="InitialFetchRangeCombo" HorizontalAlignment="Left" Width="220" Margin="25,3,0,0" ToolTip="{x:Static p:Words.InitialFetchRange}">
        <ComboBoxItem Tag="30" Content="{x:Static p:Words.InitialFetchRange30}" />
        <ComboBoxItem Tag="90" Content="{x:Static p:Words.InitialFetchRange90}" />
        <ComboBoxItem Tag="365" Content="{x:Static p:Words.InitialFetchRange365}" />
        <ComboBoxItem Tag="0" Content="{x:Static p:Words.InitialFetchRangeAll}" />
      </ComboBox>
    </StackPanel>
    <CheckBox Name="DbUpdateCompression" Content="{x:Static p:Words.MenuDbUpdateUseCompression}" Margin="0,7,0,0" />
    <CheckBox Name="DbAutoUpdates" Content="{x:Static p:Words.MenuDatabaseAutoUpdate}" Margin="0,7,0,0" />
    <CheckBox Name="LoadComments" Content="{x:Static p:Words.MenuLoadComments}" Margin="0,7,0,0" />
    <Button Name="RecreateDatabase" Content="{x:Static p:Words.MenuRecreateDatabase}" Margin="0,7,0,0" Click="RecreateDatabase_OnClick" />
  </StackPanel>
</UserControl>