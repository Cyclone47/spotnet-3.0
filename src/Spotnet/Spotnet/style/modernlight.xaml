<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Modern Light shares Classic Light's palette. What separates the two is
       the filter icons: Modern draws them from the same FontAwesome font as the
       rest of the chrome, Classic keeps the original bitmap set. Keeping the
       palettes identical here means the two styles can diverge later without
       touching anything but this file. -->
  <SolidColorBrush x:Key="SpotnetMenuBackground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SpotnetMenuForeground" Color="#FF172B40" />
  <SolidColorBrush x:Key="SpotnetMenuBorder" Color="#FF9AAABD" />
  <SolidColorBrush x:Key="SpotnetMenuHighlightBackground" Color="#FFDBEAFE" />
  <SolidColorBrush x:Key="SpotnetMenuHighlightForeground" Color="#FF102B46" />
  <SolidColorBrush x:Key="SpotnetMenuDisabledForeground" Color="#FF596579" />
  <Color x:Key="HighlightColor">#FF1E3163</Color>
  <Color x:Key="AccentColor">#FF172554</Color>
  <Color x:Key="AccentColor2">#FF1E3163</Color>
  <Color x:Key="AccentColor3">#FFDCE3F2</Color>
  <Color x:Key="AccentColor4">#FFE9EEF7</Color>
  <Color x:Key="AccentColor5">#FFF2F5FB</Color>
  <Color x:Key="NotSelectedBackground">#FFEBEFF6</Color>
  <Color x:Key="AccentColor1Background">#FF3B5488</Color>
  <Color x:Key="AccentColor2Background">#FF8E9CBE</Color>
  <Color x:Key="AccentColor3Background">#FFDCE3F2</Color>
  <Color x:Key="AccentColor4Background">#FFF4F6FA</Color>
  <Color x:Key="AccentColor5Background">#FFFFFFFF</Color>

  <!-- Tab Control Brushes -->
  <SolidColorBrush x:Key="BackgroundSelected" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="BackgroundNotSelected" Color="#FFE0E6F0" />
  <SolidColorBrush x:Key="SpotBackgroundBrush" Color="#FFFFFFFF" />

  <SolidColorBrush x:Key="NotSelectedBackgroundBrush" Color="{StaticResource NotSelectedBackground}" />
  <SolidColorBrush x:Key="AccentColor1BackgroundBrush" Color="{StaticResource AccentColor1Background}" />
  <SolidColorBrush x:Key="AccentColor2BackgroundBrush" Color="{StaticResource AccentColor2Background}" />
  <SolidColorBrush x:Key="AccentColor3BackgroundBrush" Color="{StaticResource AccentColor3Background}" />
  <SolidColorBrush x:Key="AccentColor4BackgroundBrush" Color="{StaticResource AccentColor4Background}" />
  <SolidColorBrush x:Key="AccentColor5BackgroundBrush" Color="{StaticResource AccentColor5Background}" />

  <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
  <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentColorBrush2" Color="{StaticResource AccentColor2}" />
  <SolidColorBrush x:Key="AccentColorBrush3" Color="{StaticResource AccentColor3}" />
  <SolidColorBrush x:Key="AccentColorBrush4" Color="{StaticResource AccentColor4}" />
  <SolidColorBrush x:Key="AccentColorBrush5" Color="{StaticResource AccentColor5}" />

  <SolidColorBrush x:Key="WindowTitleColorBrush" Color="#FF172554" />
  <SolidColorBrush x:Key="NonActiveWindowTitleBrush" Color="#FF1E293B" />
  <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle" Color="#FF172554" />
  <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#FF1E293B" />
  <SolidColorBrush x:Key="AccentSelectedColorBrush" Color="White" />

  <LinearGradientBrush x:Key="MainWindowBackgroundBrush" EndPoint="1,0.5" StartPoint="0,0.5">
    <GradientStop Offset="0" Color="{StaticResource AccentColor5Background}" />
    <GradientStop Offset="0.20" Color="{StaticResource AccentColor4Background}" />
    <GradientStop Offset="0.90" Color="{StaticResource AccentColor4Background}" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ProgressBrush" EndPoint="0.001,0.5" StartPoint="1.002,0.5">
    <GradientStop Offset="0" Color="{StaticResource HighlightColor}" />
    <GradientStop Offset="1" Color="{StaticResource AccentColor3}" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="CheckmarkFill" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="RightArrowFill" Color="{StaticResource AccentColor}" />

  <Color x:Key="IdealForegroundColor">White</Color>
  <SolidColorBrush x:Key="IdealForegroundColorBrush" Color="{StaticResource IdealForegroundColor}" />
  <SolidColorBrush x:Key="BlackBrush" Color="#FF000000" />
  <Color x:Key="BlackColor">#FF000000</Color>
  <SolidColorBrush x:Key="BlackColorBrush" Color="{StaticResource BlackColor}" />

  <Color x:Key="WhiteColor">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="WhiteColorBrush" Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />

  <!-- Grays for Modern Light -->
  <SolidColorBrush x:Key="GrayBrush1" Color="#FF333333" />
  <SolidColorBrush x:Key="GrayBrush2" Color="#FF666666" />
  <SolidColorBrush x:Key="GrayBrush3" Color="#FF999999" />
  <SolidColorBrush x:Key="GrayBrush4" Color="#FFB2B2B2" />
  <SolidColorBrush x:Key="GrayBrush5" Color="#FFCCCCCC" />
  <SolidColorBrush x:Key="GrayBrush6" Color="#FFD9D9D9" />
  <SolidColorBrush x:Key="GrayBrush7" Color="#FFE5E5E5" />
  <SolidColorBrush x:Key="GrayBrush8" Color="#FFF0F0F0" />
  <SolidColorBrush x:Key="GrayBrush9" Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="GrayBrush10" Color="#FFFAFAFA" />

  <!-- Dialog surfaces. Every settings/confirmation window used to paint this
       gradient inline, which left them light after a switch to Modern Dark. -->
  <LinearGradientBrush x:Key="DialogBackgroundBrush" EndPoint="0,1" StartPoint="0.5,0">
    <GradientStop Color="#FFF8FAFC" Offset="0.3" />
    <GradientStop Color="#FFE8EFF9" Offset="0.6" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="DialogPanelBackgroundBrush" Color="#CCFFFFFF" />

  <!-- Tab chrome. The active tab is a light surface carrying a 2px accent
       underline, rather than a saturated blue block. -->
  <CornerRadius x:Key="TabCornerRadius">4,4,0,0</CornerRadius>
  <Thickness x:Key="TabBorderThickness">0</Thickness>
  <Thickness x:Key="TabUnderlineThickness">0,0,0,2</Thickness>
  <SolidColorBrush x:Key="TabUnderlineBrush" Color="#FF172554" />
  <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#FF172554" />
  <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="#FFEEF2FB" />

  <!-- MahApps paints its own chrome from these, and its stock accent is the
       semi-transparent #CC0078D7 that made selections look muddy. -->
  <Color x:Key="MahApps.Colors.Accent">#FF172554</Color>
  <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="#FF172554" />
  <SolidColorBrush x:Key="MahApps.Brushes.Accent2" Color="#CC172554" />
  <SolidColorBrush x:Key="MahApps.Brushes.Accent3" Color="#99172554" />
  <SolidColorBrush x:Key="MahApps.Brushes.Accent4" Color="#66172554" />
  <SolidColorBrush x:Key="MahApps.Brushes.Highlight" Color="#FF1E3163" />

  <!-- Filter tree selection: a solid Midnight fill, so the selected filter reads
       as a block rather than a wash. -->
  <SolidColorBrush x:Key="TreeSelectedBackgroundBrush" Color="#FF172554" />
  <SolidColorBrush x:Key="TreeSelectedForegroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TreeHoverBackgroundBrush" Color="#FFE4E9F4" />
  <SolidColorBrush x:Key="TreeHoverForegroundBrush" Color="#FF16203A" />
  <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#E8F3FC" />
  <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#123B5D" />
  <SolidColorBrush x:Key="NoticeBorderBrush" Color="#82B3D8" />
  <SolidColorBrush x:Key="NoticeLinkBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="SpotRowForegroundBrush" Color="#111827" />
  <SolidColorBrush x:Key="SpotRowTrustedBrush" Color="#166534" />
  <SolidColorBrush x:Key="SpotRowMutedBrush" Color="#595959" />
  <SolidColorBrush x:Key="SpotRowFavoriteBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#B91C1C" />
</ResourceDictionary>
