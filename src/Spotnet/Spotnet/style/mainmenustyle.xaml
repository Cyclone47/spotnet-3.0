<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Spotnet.Helpers">

  <Style x:Key="SpotnetMenuSeparator" TargetType="{x:Type Separator}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,3,4,3" />
    <Setter Property="Background" Value="{DynamicResource SpotnetMenuBorder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <helpers:MenuItemStyleSelector x:Key="SpotnetMenuItemStyleSelector" />

  <Style x:Key="SpotnetToolBarStyle" TargetType="{x:Type ToolBar}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolBar}">
          <Border>
            <ToolBarPanel IsItemsHost="True" Margin="0,0,0,0" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern Dynamic Menu Style -->
  <Style x:Key="SpotnetMenuStyle" TargetType="{x:Type Menu}">
    <Style.Resources>
      <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}"
             BasedOn="{StaticResource SpotnetMenuSeparator}" />
    </Style.Resources>
    <Setter Property="ItemContainerStyleSelector" Value="{StaticResource SpotnetMenuItemStyleSelector}" />
    <Setter Property="Background" Value="{DynamicResource SpotnetMenuBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuForeground}" />
  </Style>

  <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource SpotnetMenuStyle}" />
  <Style x:Key="{x:Static ToolBar.MenuStyleKey}" TargetType="{x:Type Menu}"
         BasedOn="{StaticResource SpotnetMenuStyle}" />

  <!-- Modern Dynamic ContextMenu Style -->
  <Style TargetType="{x:Type ContextMenu}">
    <Style.Resources>
      <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}"
             BasedOn="{StaticResource SpotnetMenuSeparator}" />
    </Style.Resources>
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="ItemContainerStyleSelector" Value="{StaticResource SpotnetMenuItemStyleSelector}" />
    <Setter Property="Background" Value="{DynamicResource SpotnetMenuBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpotnetMenuBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border x:Name="MenuSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Modern Dynamic MenuItem Style

    This style must carry its own ControlTemplate. An implicit MenuItem style with no
    Template makes WPF fall back to the *system* menu template, which paints the submenu
    popup with SystemColors.MenuBrush - a light surface. Under the dark theme the
    foreground resolves to near-white, so the dropdown rendered white-on-white and was
    unreadable. Templating the popup ourselves keeps the surface on theme brushes.
  -->

  <!-- A single menu row: icon column, header, shortcut text, submenu arrow. -->
  <ControlTemplate x:Key="SpotnetMenuItemRow" TargetType="{x:Type MenuItem}">
    <Border x:Name="RowBorder"
            Background="{TemplateBinding Background}"
            TextElement.Foreground="{TemplateBinding Foreground}"
            BorderThickness="0"
            CornerRadius="3"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="SpotnetMenuIcon" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="SpotnetMenuShortcut" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ContentPresenter x:Name="Icon"
                          Grid.Column="0"
                          ContentSource="Icon"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

        <Path x:Name="Checkmark"
              Grid.Column="0"
              Visibility="Collapsed"
              Width="10" Height="10"
              VerticalAlignment="Center"
              Margin="0,0,8,0"
              Stretch="Uniform"
              Stroke="{TemplateBinding Foreground}"
              StrokeThickness="2"
              Data="M 0,5 L 4,9 L 10,0" />

        <ContentPresenter Grid.Column="1"
                          ContentSource="Header"
                          RecognizesAccessKey="True"
                          VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

        <TextBlock Grid.Column="2"
                   x:Name="ShortcutText"
                   Text="{TemplateBinding InputGestureText}"
                   Foreground="{TemplateBinding Foreground}"
                   Margin="20,0,0,0"
                   VerticalAlignment="Center" />

        <Path x:Name="SubmenuArrow"
              Grid.Column="3"
              Visibility="Collapsed"
              Width="5" Height="9"
              VerticalAlignment="Center"
              Margin="10,0,0,0"
              Stretch="Uniform"
              Fill="{TemplateBinding Foreground}"
              Data="M 0,0 L 5,4.5 L 0,9 Z" />

        <Popup x:Name="PART_Popup"
               AllowsTransparency="True"
               Focusable="False"
               HorizontalOffset="-2"
               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
               Placement="Right"
               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
          <Border x:Name="MenuPopupBorder" Background="{DynamicResource SpotnetMenuBackground}"
                  TextElement.Foreground="{DynamicResource SpotnetMenuForeground}"
                  BorderBrush="{DynamicResource SpotnetMenuBorder}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="2"
                  SnapsToDevicePixels="True">
            <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Border>
        </Popup>
      </Grid>
    </Border>

    <ControlTemplate.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="HasItems" Value="False">
        <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SpotnetMenuHighlightBackground}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SpotnetMenuHighlightBackground}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SpotnetMenuHighlightBackground}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SpotnetMenuBackground}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="SpotnetMenuItemStyle" TargetType="{x:Type MenuItem}">
    <Style.Resources>
      <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}"
             BasedOn="{StaticResource SpotnetMenuSeparator}" />
    </Style.Resources>
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="ItemContainerStyleSelector" Value="{StaticResource SpotnetMenuItemStyleSelector}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuForeground}" />
    <Setter Property="Background" Value="{DynamicResource SpotnetMenuBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4,8,4" />
    <Setter Property="Template" Value="{StaticResource SpotnetMenuItemRow}" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuHighlightForeground}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuHighlightForeground}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuHighlightForeground}" />
      </Trigger>
      <!-- Keep disabled text readable; do not fade the whole row/popup. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource SpotnetMenuDisabledForeground}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource SpotnetMenuItemStyle}" />

  <!-- WPF requests this component key when generating menu separators. -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}"
         BasedOn="{StaticResource SpotnetMenuSeparator}" />

</ResourceDictionary>
