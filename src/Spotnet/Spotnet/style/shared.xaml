<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="clr-namespace:Spotnet.ViewModel">
  <Color x:Key="WindowColor">#FFE8EDF9</Color>
  <Color x:Key="ContentAreaColorLight">#FFC5CBF9</Color>
  <Color x:Key="ContentAreaColorDark">#FF7381F9</Color>
  <SolidColorBrush x:Key="ContentAreaColorDarkBrush" Color="{StaticResource ContentAreaColorDark}" />
  <Color x:Key="DisabledControlLightColor">#FFE8EDF9</Color>
  <Color x:Key="DisabledControlDarkColor">#FFC5CBF9</Color>
  <Color x:Key="DisabledForegroundColor">#FF888888</Color>
  <Color x:Key="SelectedBackgroundColor">#FFC5CBF9</Color>
  <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>
  <Color x:Key="ControlLightColor">White</Color>
  <Color x:Key="ControlMediumColor">#FF7381F9</Color>
  <Color x:Key="ControlDarkColor">#FF211AA9</Color>
  <SolidColorBrush x:Key="ControlDarkColorBrush" Color="{StaticResource ControlDarkColor}" />
  <Color x:Key="ControlMouseOverColor">#FF3843C4</Color>
  <Color x:Key="ControlPressedColor">#FF211AA9</Color>
  <Color x:Key="GlyphColor">#FF444444</Color>
  <Color x:Key="GlyphMouseOver">sc#1, 0.004391443, 0.002428215, 0.242281124</Color>
  <SolidColorBrush x:Key="GlyphColorBrush" Color="{StaticResource GlyphColor}" />
  <SolidColorBrush x:Key="GlyphMouseOverBrush" Color="{StaticResource GlyphMouseOver}" />
  <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
  <Color x:Key="BorderMediumColor">#FF888888</Color>
  <Color x:Key="BorderDarkColor">#FF444444</Color>
  <Color x:Key="PressedBorderLightColor">#FF888888</Color>
  <Color x:Key="PressedBorderDarkColor">#FF444444</Color>
  <Color x:Key="DisabledBorderLightColor">#FFAAAAAA</Color>
  <Color x:Key="DisabledBorderDarkColor">#FF888888</Color>
  <Color x:Key="DefaultBorderBrushDarkColor">Black</Color>
  <Color x:Key="HeaderTopColor">#FFC5CBF9</Color>
  <Color x:Key="DatagridCurrentCellBorderColor">Black</Color>
  <Color x:Key="SliderTrackDarkColor">#FFC5CBF9</Color>
  <Color x:Key="NavButtonFrameColor">#FF3843C4</Color>
  <LinearGradientBrush x:Key="MenuPopupBrush" EndPoint="0.5,1" StartPoint="0.5,0">
    <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
    <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="0.5" />
    <GradientStop Color="{DynamicResource ControlLightColor}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
    <GradientBrush.GradientStops>
      <GradientStopCollection>
        <GradientStop Color="#000000FF" Offset="0" />
        <GradientStop Color="#600000FF" Offset="0.4" />
        <GradientStop Color="#600000FF" Offset="0.6" />
        <GradientStop Color="#000000FF" Offset="1" />
      </GradientStopCollection>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <VisualBrush x:Key="HatchBrushGrayLight" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Canvas>
        <Rectangle Width="3" Height="3" Fill="{StaticResource WhiteColorBrush}" />
        <Path Data="M1,0 L2,2" Stroke="{StaticResource GrayBrush10}" />
        <Path Data="M0,1 L2,2" Stroke="{StaticResource GrayBrush10}" />
      </Canvas>
    </VisualBrush.Visual>
  </VisualBrush>
  <VisualBrush x:Key="HatchBrushGray" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Canvas>
        <Rectangle Width="3" Height="3" Fill="{StaticResource GrayBrush10}" />
        <Path Data="M1,0 L2,2" Stroke="{StaticResource GrayBrush9}" />
        <Path Data="M0,1 L2,2" Stroke="{StaticResource GrayBrush9}" />
      </Canvas>
    </VisualBrush.Visual>
  </VisualBrush>
  <VisualBrush x:Key="HatchBrushAccent1" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Canvas>
        <Rectangle Width="3" Height="3" Fill="{StaticResource GrayBrush7}" />
        <Path Data="M1,0 L2,2" Stroke="{StaticResource AccentColorBrush}" />
        <Path Data="M0,1 L2,2" Stroke="{StaticResource AccentColorBrush}" />
      </Canvas>
    </VisualBrush.Visual>
  </VisualBrush>
  <VisualBrush x:Key="HatchBrushAccent2" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Canvas>
        <Rectangle Width="3" Height="3" Fill="{StaticResource GrayBrush9}" />
        <Path Data="M1,0 L2,2" Stroke="{StaticResource AccentColorBrush3}" />
        <Path Data="M0,1 L2,2" Stroke="{StaticResource AccentColorBrush3}" />
      </Canvas>
    </VisualBrush.Visual>
  </VisualBrush>
  <VisualBrush x:Key="HatchBrushAccent3" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Canvas>
        <Rectangle Width="3" Height="3" Fill="{StaticResource GrayBrush10}" />
        <Path Data="M1,0 L2,2" Stroke="{StaticResource AccentColorBrush4}" />
        <Path Data="M0,1 L2,2" Stroke="{StaticResource AccentColorBrush4}" />
      </Canvas>
    </VisualBrush.Visual>
  </VisualBrush>
  <Color x:Key="SpotBackground">#F9F9F9</Color>
  <SolidColorBrush x:Key="SpotBackgroundBrush" Color="{StaticResource SpotBackground}" />
  <Color x:Key="BrightColor1">#FFFF0000</Color>
  <Color x:Key="BrightColor2">#CCFF0000</Color>
  <Color x:Key="BrightColor3">#99FF0000</Color>
  <Color x:Key="BrightColor4">#55FF0000</Color>
  <Color x:Key="BrightColor5">#22FF0000</Color>
  <SolidColorBrush x:Key="BrightColorBrush1" Color="{StaticResource BrightColor1}" />
  <SolidColorBrush x:Key="BrightColorBrush2" Color="{StaticResource BrightColor2}" />
  <SolidColorBrush x:Key="BrightColorBrush3" Color="{StaticResource BrightColor3}" />
  <SolidColorBrush x:Key="BrightColorBrush4" Color="{StaticResource BrightColor4}" />
  <SolidColorBrush x:Key="BrightColorBrush5" Color="{StaticResource BrightColor5}" />
  <Color x:Key="BrightDarkColor1">#FFAA0000</Color>
  <Color x:Key="BrightDarkColor2">#CCAA0000</Color>
  <Color x:Key="BrightDarkColor3">#99AA0000</Color>
  <Color x:Key="BrightDarkColor4">#55AA0000</Color>
  <Color x:Key="BrightDarkColor5">#22AA0000</Color>
  <SolidColorBrush x:Key="BrightDarkColorBrush1" Color="{StaticResource BrightDarkColor1}" />
  <SolidColorBrush x:Key="BrightDarkColorBrush2" Color="{StaticResource BrightDarkColor2}" />
  <SolidColorBrush x:Key="BrightDarkColorBrush3" Color="{StaticResource BrightDarkColor3}" />
  <SolidColorBrush x:Key="BrightDarkColorBrush4" Color="{StaticResource BrightDarkColor4}" />
  <SolidColorBrush x:Key="BrightDarkColorBrush5" Color="{StaticResource BrightDarkColor5}" />
  <SolidColorBrush x:Key="TransparentWhiteBrush1" Color="#AAFFFFFF" />
  <SolidColorBrush x:Key="TransparentWhiteBrush2" Color="#CCFFFFFF" />
  <Style x:Key="FontAwesome">
    <Setter Property="TextElement.FontFamily" Value="pack://application:,,,/Resources/#FontAwesome" />
    <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center" />
    <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
    <Setter Property="TextElement.FontSize" Value="15" />
  </Style>
  <Style x:Key="FontAwesomeTabs" BasedOn="{StaticResource FontAwesome}">
    <Setter Property="FrameworkElement.Margin" Value="2,3,2,0" />
  </Style>
  <Style x:Key="FontAwesomePlayer" BasedOn="{StaticResource FontAwesome}">
    <Setter Property="FrameworkElement.Margin" Value="4,0" />
    <Setter Property="TextElement.FontSize" Value="14" />
    <Setter Property="TextElement.Foreground" Value="#FFD3D3D3" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
        <Setter Property="TextElement.Foreground" Value="#FFFF6666" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FontAwesomeDownloadItemPlay" BasedOn="{StaticResource FontAwesome}">
    <Setter Property="TextElement.FontSize" Value="14" />
    <Setter Property="TextElement.Foreground" Value="#FF808080" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
        <Setter Property="TextElement.Foreground" Value="#FFFF6666" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FontAwesomeMenuPics" BasedOn="{StaticResource FontAwesome}" />
  <!-- Dynamic resources repaint cached/recycled rows without a database reload. -->
  <Style x:Key="SpotRowTextStyle" TargetType="{x:Type FrameworkElement}">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SpotRowForegroundBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Data.PosterIdent}" Value="{x:Static model:PosterIdentType.White}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SpotRowTrustedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Data.PosterIdent}" Value="{x:Static model:PosterIdentType.Black}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SpotRowMutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Data.IsInFavorites}" Value="True">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SpotRowFavoriteBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
