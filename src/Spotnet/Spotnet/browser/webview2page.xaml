<UserControl x:Class="Spotnet.Browser.WebView2Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:browser="clr-namespace:Spotnet.Browser">
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SpotBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:WarningTip x:Name="Warning" Grid.Row="0" Visibility="Collapsed" Focusable="False" Margin="0,1,0,0" />
    <Popup Name="ToolbarPopup" Grid.Row="1" IsOpen="False" StaysOpen="True" AllowsTransparency="True" Placement="Custom" PlacementTarget="{Binding ElementName=WebGrid}">
      <controls:SpotToolbar x:Name="Toolbar" Width="Auto" Background="{StaticResource TransparentWhiteBrush2}" />
    </Popup>
    <Grid Name="WebGrid" Row="1" Visibility="Collapsed" />
    <TextBlock Name="UnavailableMessage" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
  </Grid>
  <FrameworkElement.ContextMenu>
    <ContextMenu Name="SpotMenu" />
  </FrameworkElement.ContextMenu>
</UserControl>
