<metro:MetroWindow x:Class="Spotnet.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:vm="clr-namespace:Spotnet.ViewModel" xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" x:Name="MainWindowName" SizeToContent="Manual" Cursor="Wait" Style="{DynamicResource WindowBackground}" FontSize="{DynamicResource NormalFontSize}" ResizeMode="CanResizeWithGrip" MinWidth="400" MinHeight="300" Width="1120" Height="660" WindowStartupLocation="CenterScreen" SaveWindowPosition="True" WindowTransitionsEnabled="False" Icon="/Resources/ImagesInternal/spotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" ShowActivated="True" SnapsToDevicePixels="True" GlowBrush="{DynamicResource HighlightBrush}" TextOptions.TextFormattingMode="Display" xmlns:views="clr-namespace:Spotnet.Views" DataContext="{Binding MainWindow, Source={StaticResource Locator}}" Loaded="MainWindow_OnLoaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="..\Style\MainWindowStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <metro:MetroWindow.RightWindowCommands>
    <metro:WindowCommands>
      <controls:NotificationBellTitleBarControl />
      <controls:RemoteStatusTitleBarControl />
    </metro:WindowCommands>
  </metro:MetroWindow.RightWindowCommands>
  <UIElement.CommandBindings>
    <CommandBinding Command="vm:CustomCommands.CopySpotToWhiteCommand" Executed="ExecuteFillAddSpotToExtWhitelist" />
    <CommandBinding Command="vm:CustomCommands.CopySpotToBlackCommand" Executed="ExecuteFillAddSpotToExtBlacklist" />
    <CommandBinding Command="vm:CustomCommands.CopyPosterAndModulusToWhiteCommand" Executed="ExecuteFillAddToExtWhitelist" />
    <CommandBinding Command="vm:CustomCommands.CopyPosterAndModulusToBlackCommand" Executed="ExecuteFillAddToExtBlacklist" />
    <CommandBinding Command="vm:CustomCommands.UpdateDbCommand" Executed="ResetNewSpotsCountAndStartDbUpdateTimer" />
    <CommandBinding Command="vm:CustomCommands.AddNewSpotCommand" Executed="ExecuteAddNewSpot" />
    <CommandBinding Command="vm:CustomCommands.OpenNzbCommand" Executed="ExecuteOpenNzb" />
    <CommandBinding Command="vm:CustomCommands.OpenSpotlinkCommand" Executed="ExecuteOpenSpotlink" />
    <CommandBinding Command="vm:CustomCommands.SelectProviderCommand" Executed="ExecuteSelectProvider" />
    <CommandBinding Command="vm:CustomCommands.DownloadFolderChangeCommand" Executed="ExecuteDownloadFolderChange" />
    <CommandBinding Command="vm:CustomCommands.CloseTabCommand" Executed="ExecuteCloseActiveTab" />
    <CommandBinding Command="vm:CustomCommands.TestCommand" Executed="TestCommandOnClick" />
    <CommandBinding Command="vm:CustomCommands.GotoTab1" Executed="GotoTab1" />
    <CommandBinding Command="vm:CustomCommands.GotoTab2" Executed="GotoTab2" />
    <CommandBinding Command="vm:CustomCommands.GotoTab3" Executed="GotoTab3" />
    <CommandBinding Command="vm:CustomCommands.GotoTab4" Executed="GotoTab4" />
    <CommandBinding Command="vm:CustomCommands.GotoTab5" Executed="GotoTab5" />
    <CommandBinding Command="vm:CustomCommands.GotoTab6" Executed="GotoTab6" />
    <CommandBinding Command="vm:CustomCommands.GotoTab7" Executed="GotoTab7" />
    <CommandBinding Command="vm:CustomCommands.GotoTab8" Executed="GotoTab8" />
    <CommandBinding Command="vm:CustomCommands.GotoTab9" Executed="GotoTab9" />
  </UIElement.CommandBindings>
  <UIElement.InputBindings>
    <KeyBinding Modifiers="Control" Key="F" Command="vm:CustomCommands.CopySpotToWhiteCommand" />
    <KeyBinding Modifiers="Control" Key="G" Command="vm:CustomCommands.CopySpotToBlackCommand" />
    <KeyBinding Modifiers="Control" Key="V" Command="vm:CustomCommands.CopyPosterAndModulusToWhiteCommand" />
    <KeyBinding Modifiers="Control" Key="B" Command="vm:CustomCommands.CopyPosterAndModulusToBlackCommand" />
    <KeyBinding Modifiers="Control" Key="U" Command="vm:CustomCommands.UpdateDbCommand" />
    <KeyBinding Modifiers="Control" Key="N" Command="vm:CustomCommands.AddNewSpotCommand" />
    <KeyBinding Modifiers="Control" Key="O" Command="vm:CustomCommands.OpenNzbCommand" />
    <KeyBinding Modifiers="Control" Key="L" Command="vm:CustomCommands.OpenSpotlinkCommand" />
    <KeyBinding Modifiers="Control" Key="P" Command="vm:CustomCommands.SelectProviderCommand" />
    <KeyBinding Modifiers="Control" Key="D" Command="vm:CustomCommands.DownloadFolderChangeCommand" />
    <KeyBinding Modifiers="Control" Key="W" Command="vm:CustomCommands.CloseTabCommand" />
    <KeyBinding Modifiers="Control" Key="X" Command="vm:CustomCommands.TestCommand" />
    <KeyBinding Modifiers="Control" Key="F4" Command="vm:CustomCommands.CloseTabCommand" />
    <KeyBinding Modifiers="Control" Key="D1" Command="vm:CustomCommands.GotoTab1" />
    <KeyBinding Modifiers="Control" Key="D2" Command="vm:CustomCommands.GotoTab2" />
    <KeyBinding Modifiers="Control" Key="D3" Command="vm:CustomCommands.GotoTab3" />
    <KeyBinding Modifiers="Control" Key="D4" Command="vm:CustomCommands.GotoTab4" />
    <KeyBinding Modifiers="Control" Key="D5" Command="vm:CustomCommands.GotoTab5" />
    <KeyBinding Modifiers="Control" Key="D6" Command="vm:CustomCommands.GotoTab6" />
    <KeyBinding Modifiers="Control" Key="D7" Command="vm:CustomCommands.GotoTab7" />
    <KeyBinding Modifiers="Control" Key="D8" Command="vm:CustomCommands.GotoTab8" />
    <KeyBinding Modifiers="Control" Key="D9" Command="vm:CustomCommands.GotoTab9" />
  </UIElement.InputBindings>
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo Description="Spotnet" ProgressValue="{Binding ElementName=StatusBarVmProxy, Path=DataContext.TaskBarProgressValue, Mode=OneWay}" ProgressState="{Binding ElementName=StatusBarVmProxy, Path=DataContext.TaskBarProgressState, Mode=OneWay}" />
  </Window.TaskbarItemInfo>
  <Grid Name="Dock" Height="Auto" Width="Auto" HorizontalAlignment="Stretch" ClipToBounds="False">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <FrameworkElement Name="VisibilityVmProxy" Grid.Row="0" Grid.Column="0" DataContext="{Binding Visibility, Source={StaticResource Locator}}" />
    <FrameworkElement Name="SpotsListVmProxy" Grid.Row="0" Grid.Column="0" DataContext="{Binding SpotsList, Source={StaticResource Locator}}" />
    <FrameworkElement Name="StatusBarVmProxy" Grid.Row="0" Grid.Column="0" DataContext="{Binding StatusBar, Source={StaticResource Locator}}" />
    <Grid Name="LeftPanelMainGrid" Row="0" RowSpan="4" Column="0" Margin="0,0,0,0" Visibility="{Binding ElementName=VisibilityVmProxy, Path=DataContext.IsVisibleLeftPanel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="4,4,4,0" HorizontalAlignment="Stretch" Width="Auto" SizeChanged="LeftPanel_OnSizeChanged">
        <!-- The view-mode buttons used to sit to the right of the menu here. They only
             ever got the width the menu did not take, so a menu that grew clipped them.
             They are entries in the View menu now. -->
        <DockPanel Name="MainToolBarDockInLeftPanel" LastChildFill="True" Opacity="1" />
      </Grid>
      <controls:LeftPanelUserControl Grid.Row="1" />
    </Grid>
    <GridSplitter Name="LeftPanelSplitter" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Height="Auto" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" MouseDoubleClick="LeftPanelSplitter_OnMouseDoubleClick">
      <FrameworkElement.Style>
        <Style>
          <Setter Property="Control.Background" Value="#00FFFFFF" />
          <Style.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Control.Background" Value="{StaticResource AccentColorBrush3}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </GridSplitter>
    <DockPanel Name="MainToolBarDockInTop" Grid.Row="0" Grid.Column="1" Dock="Top" LastChildFill="True" Opacity="1" />
    <DockPanel Grid.Row="3" Grid.Column="1" Dock="Bottom" LastChildFill="True" Opacity="1" Visibility="{Binding ElementName=VisibilityVmProxy, Path=DataContext.IsVisibleStatusBar, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VisibilityConverter}}">
      <Panel.Background>
        <SolidColorBrush Color="White" Opacity="0" />
      </Panel.Background>
      <StatusBar Margin="0,0,10,2" FontSize="{DynamicResource ContentFontSize}" Foreground="{DynamicResource BlackBrush}" Background="{x:Null}" DataContext="{Binding StatusBar, Source={StaticResource Locator}}">
        <StatusBarItem DockPanel.Dock="Right" Margin="2,0">
          <Grid>
            <Popup Name="StatusBarSystemStatePopup" Placement="Top" VerticalOffset="-5" HorizontalOffset="-180" AllowsTransparency="True" PlacementTarget="{Binding ElementName=StatusBarSystemStateImage}" IsOpen="{Binding ElementName=StatusBarSystemStateTooltip, Path=TooltipIsVisible, UpdateSourceTrigger=PropertyChanged}">
              <controls:SystemStatusTooltip x:Name="StatusBarSystemStateTooltip" Background="#00FFFFFF" TooltipTitle="{x:Static p:Words.StateReporter}" TooltipText="{Binding SystemStateText, Mode=OneWay}" TooltipType="{Binding SystemStateType, Mode=OneWay}" Visibility="{Binding Path=IsActive, ElementName=MainWindowName, Converter={StaticResource VisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
            </Popup>
            <Image Name="StatusBarSystemStateImage" Height="14" Width="14" Cursor="Hand" ToolTipService.HasDropShadow="True" ToolTipService.Placement="Top" Source="{Binding SystemStateImageSource, Mode=OneWay}" ToolTip="{Binding SystemStateText, Mode=OneWay}" MouseDown="SystemStateImage_MouseDown" IsMouseDirectlyOverChanged="StatusBarSystemStateImage_OnIsMouseDirectlyOverChanged" />
          </Grid>
        </StatusBarItem>
        <StatusBarItem DockPanel.Dock="Right" Margin="2,0" Visibility="{Binding ProxyIconVisibility, Mode=OneWay}">
          <Grid>
            <Popup Name="StatusBarSocksProxyPopup" Placement="Top" VerticalOffset="-5" HorizontalOffset="-160" AllowsTransparency="True" PlacementTarget="{Binding ElementName=ProxyIcon}" IsOpen="{Binding ElementName=StatusBarSocksProxyTooltip, Path=TooltipIsVisible, UpdateSourceTrigger=PropertyChanged}">
              <controls:SocksProxyTooltip x:Name="StatusBarSocksProxyTooltip" Background="#00FFFFFF" Visibility="{Binding Path=IsActive, ElementName=MainWindowName, Converter={StaticResource VisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
            </Popup>
            <TextBlock Name="ProxyIcon" Width="14" TextAlignment="Center" Style="{StaticResource FontAwesome}" Cursor="Hand" ToolTipService.HasDropShadow="True" ToolTipService.Placement="Top" Text="{Binding ProxyIcon, Mode=OneWay}" Foreground="{Binding ProxyIconForeground, Mode=OneWay}" ToolTip="{Binding ProxyIconToolTip, Mode=OneWay}" MouseDown="ProxyIcon_MouseDown" IsMouseDirectlyOverChanged="StatusBarSocksProxy_OnIsMouseDirectlyOverChanged" />
          </Grid>
        </StatusBarItem>
        <Separator DockPanel.Dock="Right" Margin="3,3" />
        <StatusBarItem DockPanel.Dock="Right" Margin="2,0">
          <TextBlock Name="StatusBarUpdateIcon" Style="{StaticResource FontAwesome}" ToolTipService.HasDropShadow="True" ToolTipService.Placement="Top" Text="{Binding DbUpdateIcon, Mode=OneWay}" Foreground="{Binding DbUpdateIconForeground, Mode=OneWay}" Cursor="{Binding DbUpdateImageCursor, Mode=OneWay}" ToolTip="{Binding DbUpdateImageToolTip, Mode=OneWay}" MouseDown="ExecuteUpdateDb_MouseDown" />
        </StatusBarItem>
        <StatusBarItem DockPanel.Dock="Right">
          <ProgressBar Name="StatusBarProgressBar" Width="80" Height="18" Value="{Binding StatusBarProgressValue, Mode=OneWay}" ToolTip="{Binding StatusBarProgressTooltip, Mode=OneWay}" IsIndeterminate="{Binding StatusBarProgressIndeterminate, Mode=OneWay}" />
        </StatusBarItem>
        <StatusBarItem DockPanel.Dock="Right" HorizontalContentAlignment="Right">
          <TextBlock Text="{Binding DbUpdateStatusMessage, Mode=OneWay}" />
        </StatusBarItem>
        <StatusBarItem Name="StatusBarFirstContainer" />
      </StatusBar>
    </DockPanel>
    <ItemsControl Name="WarningsPanel" Grid.Row="1" Grid.Column="1" DockPanel.Dock="Top" ItemsSource="{Binding WarningsList}" />
    <TabControl Name="TabControl1" Grid.Row="2" Grid.Column="1" Height="Auto" Width="Auto" Margin="0,4,0,0" BorderThickness="0" Style="{DynamicResource StandardTabControl}" SelectionChanged="TabControl1_SelectionChanged">
      <controls:UnCloseableTabItem x:Name="SpotsTab" IsDownloadTab="False" AllowDrop="False" IsSelected="True" Content="{Binding ElementName=SpotsListVmProxy, Path=DataContext.SpotsContainer, Mode=OneWay}" DataContext="{Binding SpotsList, Source={StaticResource Locator}}">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" Style="{StaticResource FontAwesomeTabs}" />
            <TextBlock Text="{x:Static p:Words.TabSpots}" Margin="4,0,4,0" VerticalAlignment="Center" />
          </StackPanel>
        </HeaderedContentControl.Header>
      </controls:UnCloseableTabItem>
      <controls:UnCloseableTabItem x:Name="DownloadsTab" IsDownloadTab="True" AllowDrop="False" IsSelected="False" IsEnabled="True">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" Style="{StaticResource FontAwesomeTabs}" />
            <TextBlock Text="{x:Static p:Words.TabDownloads}" Margin="4,0,4,0" VerticalAlignment="Center" />
          </StackPanel>
        </HeaderedContentControl.Header>
      </controls:UnCloseableTabItem>
    </TabControl>
  </Grid>
</metro:MetroWindow>