<metro:MetroWindow x:Class="Spotnet.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" xmlns:p="clr-namespace:Spotnet.Properties" Title="{x:Static p:Words.About}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Manual" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" Height="660" Width="580" WindowTransitionsEnabled="True" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" Background="{DynamicResource DialogBackgroundBrush}">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Wordmark and version -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Spotnet" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" />
      <TextBlock Name="VersionLabel" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource BlackColorBrush}" />
      <TextBlock Name="UpdateLabel" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource GrayBrush2}" />
    </StackPanel>

    <Rectangle Grid.Row="1" Height="1" Margin="0,16,0,16" Fill="{DynamicResource GrayBrush7}" />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- Where it comes from -->
        <TextBlock Text="{x:Static p:Words.AboutOriginHeader}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BlackColorBrush}" />
        <TextBlock Text="{x:Static p:Words.AboutOriginBody}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource BlackColorBrush}" />

        <!-- What 3.0 changed -->
        <TextBlock Text="{x:Static p:Words.AboutChangesHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0" Foreground="{DynamicResource BlackColorBrush}" />
        <ItemsControl Name="ChangesList" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x2022;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentColorBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource BlackColorBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Project link and dismiss -->
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{x:Static p:Words.AboutProjectHeader}" FontSize="11" Foreground="{DynamicResource GrayBrush2}" />
        <TextBlock Margin="0,1,0,0">
          <Hyperlink Name="ProjectLink" NavigateUri="https://github.com/Cyclone47/spotnet-3.0/" RequestNavigate="ProjectLink_RequestNavigate" Foreground="{DynamicResource AccentColorBrush}">
            <Run Text="github.com/Cyclone47/spotnet-3.0" FontSize="12" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="1" Name="CloseButton" Content="{x:Static p:Words.Close}" MinWidth="92" Height="30" VerticalAlignment="Bottom" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
    </Grid>
  </Grid>
</metro:MetroWindow>
