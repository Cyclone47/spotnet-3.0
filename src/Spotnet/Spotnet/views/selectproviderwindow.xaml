<metro:MetroWindow x:Class="Spotnet.Views.SelectProviderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.SelectProvider}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Width="720" Height="700" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource AccentColorBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:views="clr-namespace:Spotnet.Views" Background="{DynamicResource GrayBrush10}" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- The invalid-field cue is a border colour rather than a LemonChiffon fill, so it stays
           readable under the ModernDark theme. -->
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GrayBrush7}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,16,20,18" />
        <Setter Property="Margin" Value="0,0,0,14" />
      </Style>

      <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GrayBrush1}" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>

      <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GrayBrush2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>

      <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GrayBrush1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
      </Style>

      <!-- Every editable field sits in a named Border so the validation storyboard has a target. -->
      <Style x:Key="FieldBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>

      <Style x:Key="ProviderGroupHeaderStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupItem}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource GrayBrush2}" Margin="10,8,10,4" />
                <Border Height="1" Background="{DynamicResource GrayBrush7}" Margin="10,0,10,4" />
                <ItemsPresenter />
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <DataTemplate x:Key="ProviderItemTemplate">
        <StackPanel Margin="2,3,2,3">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource GrayBrush1}" />
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource GrayBrush2}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource WhiteBrush}" BorderBrush="{DynamicResource GrayBrush7}" BorderThickness="0,0,0,1" Padding="24,18,24,18">
      <StackPanel>
        <TextBlock Text="{x:Static p:Words.SelectProvider}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource GrayBrush1}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static p:Words.SelectProviderSubtitle}" Foreground="{DynamicResource GrayBrush2}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24,18,24,6">
      <StackPanel>

        <!-- Provider -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{x:Static p:Words.Provider}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Text="{x:Static p:Words.SearchProviderHint}" />
            <ComboBox Name="ProviderBox" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False" StaysOpenOnEdit="True" MaxDropDownHeight="340" Height="32" TabIndex="0" ItemTemplate="{StaticResource ProviderItemTemplate}" GotFocus="ProviderBox_GotFocus" PreviewKeyDown="ProviderBox_PreviewKeyDown" PreviewTextInput="ProviderBox_PreviewTextInput" DropDownClosed="ProviderBox_DropDownClosed">
              <ItemsControl.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource ProviderGroupHeaderStyle}" />
              </ItemsControl.GroupStyle>
            </ComboBox>
            <TextBlock Name="ProviderCountLabel" FontSize="11" Foreground="{DynamicResource GrayBrush2}" Margin="2,6,0,0" />
          </StackPanel>
        </Border>

        <!-- Account -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{x:Static p:Words.Account}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Text="{x:Static p:Words.AccountSectionHint}" />
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="UsernameLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.Username}" />
              <Border Name="UserNameTextBoxBorder" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,8">
                <TextBox Name="UserNameTextBox" Height="30" TabIndex="1" ToolTip="{x:Static p:Words.EnterUsername}" GotFocus="UserNameTextBox_GotFocus" TextChanged="UserNameTextBox_OnTextChanged" />
              </Border>
              <TextBlock Name="PasswordLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.Password}" />
              <Border Name="PasswordTextBoxBorder" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <PasswordBox Name="PasswordTextBox" Height="30" TabIndex="2" ToolTip="{x:Static p:Words.EnterPassword}" GotFocus="PasswordTextBox_GotFocus" PasswordChanged="PasswordTextBox_OnPasswordChanged" />
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Style="{StaticResource CardStyle}" Padding="20,6,20,10">
          <!-- The header needs its own template: the MahApps Expander style pins a foreground that
               stays dark under ModernDark. -->
          <Expander Name="AdvancedSettingsExpander" IsExpanded="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource GrayBrush1}">
            <Expander.Header>
              <TextBlock Text="{x:Static p:Words.AdvancedSettings}" FontWeight="SemiBold" Foreground="{DynamicResource GrayBrush1}" VerticalAlignment="Center" />
            </Expander.Header>
            <Grid Margin="0,14,0,6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.HeadersServer}" />
              <Border Name="HeaderServerTextBoxBorder" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,8,8">
                <TextBox Name="HeaderServerTextBox" Height="30" TabIndex="3" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="HeaderServerTextBox_GotFocus" TextChanged="HeaderServerTextBox_TextChanged" />
              </Border>
              <Border Name="HeaderServerPortComboBoxBorder" Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,8">
                <ComboBox Name="HeaderServerPortComboBox" IsEditable="True" Height="30" TabIndex="4" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="HeaderServerPortComboBox_GotFocus" TextBoxBase.TextChanged="HeaderServerPortComboBox_OnTextChanged">
                  <ComboBoxItem Content="563" IsSelected="True" />
                  <ComboBoxItem Content="443" />
                  <ComboBoxItem Content="119" />
                  <ComboBoxItem Content="80" />
                </ComboBox>
              </Border>

              <CheckBox Name="DownloadServerCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="{x:Static p:Words.SeparateDownloadServer}" Foreground="{DynamicResource GrayBrush1}" Margin="0,4,0,6" Checked="DownloadServerCheckBox_OnChecked" Unchecked="DownloadServerCheckBox_OnUnchecked" />
              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.DownloadServer}" />
              <Border Name="DownloadServerTextBoxBorder" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,8,8">
                <TextBox Name="DownloadServerTextBox" Height="30" TabIndex="5" IsEnabled="False" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="DownloadServerTextBox_GotFocus" TextChanged="DownloadServerTextBox_TextChanged" />
              </Border>
              <Border Name="DownloadServerPortComboBoxBorder" Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,8">
                <ComboBox Name="DownloadServerPortComboBox" IsEditable="True" Height="30" TabIndex="6" IsEnabled="False" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="DownloadServerPortComboBox_GotFocus">
                  <ComboBoxItem Content="563" IsSelected="True" />
                  <ComboBoxItem Content="443" />
                  <ComboBoxItem Content="119" />
                  <ComboBoxItem Content="80" />
                </ComboBox>
              </Border>

              <CheckBox Name="UploadServerCheckBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="{x:Static p:Words.SeparateUploadServer}" Foreground="{DynamicResource GrayBrush1}" Margin="0,4,0,6" Checked="UploadServerCheckBox_OnChecked" Unchecked="UploadServerCheckBox_OnUnchecked" />
              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.UploadServer}" />
              <Border Name="UploadServerTextBoxBorder" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBorderStyle}" Margin="0,0,8,8">
                <TextBox Name="UploadServerTextBox" Height="30" TabIndex="7" IsEnabled="False" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="UploadServerTextBox_GotFocus" TextChanged="UploadServerTextBox_TextChanged" />
              </Border>
              <Border Name="UploadServerPortComboBoxBorder" Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldBorderStyle}" Margin="0,0,0,8">
                <ComboBox Name="UploadServerPortComboBox" IsEditable="True" Height="30" TabIndex="8" IsEnabled="False" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="UploadServerPortComboBox_GotFocus">
                  <ComboBoxItem Content="563" IsSelected="True" />
                  <ComboBoxItem Content="443" />
                  <ComboBoxItem Content="119" />
                  <ComboBoxItem Content="80" />
                </ComboBox>
              </Border>

              <TextBlock Name="ConnectionsLabel" Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{x:Static p:Words.Connections}" />
              <ComboBox Name="ConnectionsCombo" Grid.Row="5" Grid.Column="1" IsEditable="True" Height="30" TabIndex="9" ToolTip="{x:Static p:Words.SelectNumberOfConnections}" Margin="0,0,8,0">
                <ComboBoxItem Content="Auto" IsSelected="True" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="8" />
                <ComboBoxItem Content="10" />
                <ComboBoxItem Content="12" />
                <ComboBoxItem Content="16" />
                <ComboBoxItem Content="18" />
                <ComboBoxItem Content="20" />
                <ComboBoxItem Content="30" />
              </ComboBox>

              <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource HintTextStyle}" FontSize="11" Margin="0,12,0,0" Text="{x:Static p:Words.ConnectionSecuredWithSsl}" />
            </Grid>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource WhiteBrush}" BorderBrush="{DynamicResource GrayBrush7}" BorderThickness="0,1,0,0" Padding="24,14,24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <controls:ProgressRing x:Name="ConnectProgressRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Name="StatusLabel" Foreground="{DynamicResource GrayBrush2}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Name="CancelButton" MinWidth="118" Height="34" IsEnabled="True" Content="{x:Static p:Words.Cancel}" TabIndex="11" Margin="0,0,10,0" Click="CancelButton_Click" />
          <Button Name="ConnectButton" MinWidth="140" Height="34" IsDefault="True" IsEnabled="False" TabIndex="10" Content="{x:Static p:Words.Connect}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Click="ConnectButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBox Name="HiddenPortTextBox" Visibility="Collapsed" Text="{Binding Text, ElementName=HeaderServerPortComboBox}" TextChanged="HiddenPortTextBox_OnTextChanged" />
    <TextBox Name="HiddenConnectionsTextBox" Visibility="Collapsed" Text="{Binding Text, ElementName=ConnectionsCombo}" TextChanged="HiddenConnectionsTextBox_OnTextChanged" />
  </Grid>
</metro:MetroWindow>
