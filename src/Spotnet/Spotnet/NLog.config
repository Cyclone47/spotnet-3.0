<?xml version="1.0" encoding="utf-8"?>
<!--
  Logging configuration.

  This lived in app.config. NLog reads a configuration section from app.config only on
  .NET Framework; from .NET Core onward it looks for this file instead, so the settings
  moved here where both find them. The file target's path is supplied at startup through
  the "logfile" diagnostic context value, because it depends on which profile is open.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets async="true">
    <target name="logfile" xsi:type="File" fileName="${gdc:logfile}"
            layout="${longdate} ${level:upperCase=true} [${callsite}] ${message}"
            archiveFileName="${gdc:logfile}.{#}.backup" archiveAboveSize="5242880"
            archiveEvery="Day" archiveNumbering="Rolling" maxArchiveFiles="3" />
    <target name="console" xsi:type="Console" />
  </targets>
  <rules>
    <logger name="*" minLevel="Debug" writeTo="logfile" />
    <logger name="*" minLevel="Debug" writeTo="console" />
  </rules>
</nlog>
