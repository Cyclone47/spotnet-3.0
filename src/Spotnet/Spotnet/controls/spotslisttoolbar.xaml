<UserControl x:Class="Spotnet.Controls.SpotsListToolbar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BitmapImage x:Key="PlayIcon" UriSource="..\Resources\ImagesInternal\playiconsmall.png" />
      <BitmapImage x:Key="DownloadNzbIcon" UriSource="..\Resources\ImagesInternal\button.ico" />
      <BitmapImage x:Key="ComplainIcon" UriSource="..\Resources\ImagesInternal\warning.ico" />
      <BitmapImage x:Key="DeleteIcon" UriSource="..\Resources\ImagesInternal\delete.ico" />
      <BitmapImage x:Key="WhiteListIcon" UriSource="..\Resources\ImagesInternal\favorite.ico" />
      <BitmapImage x:Key="BlackListIcon" UriSource="..\Resources\ImagesInternal\trash.ico" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainToolbarGrid" Width="Auto" VerticalAlignment="Center" Visibility="{Binding VisibilityMainToolbar}">
    <DockPanel Width="Auto" VerticalAlignment="Center" Height="{Binding PanelHeight}">
      <ToolBarPanel DockPanel.Dock="Top" VerticalAlignment="Center">
        <ToolBar Name="Toolbar" OverflowMode="Never" ToolBarTray.IsLocked="True" VerticalAlignment="Center" Loaded="ToolBar_Loaded">
          <DockPanel>
            <Image Margin="2,0,1,0" ToolTip="{Binding TooltipFavorites}" Cursor="{Binding CursorFavorites}" Width="{Binding IconSize}" Height="{Binding IconSize}" Opacity="{Binding OpacityFavorites}" MouseLeftButtonUp="Favorites_MouseLeftButtonUp">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Image}">
                  <Setter Property="Source" Value="{Binding FavIcon}" />
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Source" Value="{Binding FavIcon2}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Image>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="1,0,1,0" />
            <Image Source="{StaticResource PlayIcon}" Margin="1,0,1,0" ToolTip="{Binding TooltipPlay}" Cursor="{Binding CursorPlay}" Width="{Binding IconSize}" Visibility="{Binding VisibilityPlay}" Opacity="{Binding OpacityDownloadNzb}" MouseLeftButtonUp="Play_MouseLeftButtonUp" />
            <Image Source="{StaticResource DownloadNzbIcon}" Margin="1,0,1,0" ToolTip="{Binding TooltipDownloadNzb}" Cursor="{Binding CursorDownloadNzb}" Width="{Binding IconSize}" Opacity="{Binding OpacityDownloadNzb}" MouseLeftButtonUp="DownloadNzb_MouseLeftButtonUp" />
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="1,0,1,0" />
            <Image Name="ComplainImg" Source="{StaticResource ComplainIcon}" ToolTip="{x:Static p:Words.ComplainToSpot}" Cursor="Hand" Margin="1,0,1,0" Width="{Binding IconSize}" MouseLeftButtonUp="Complain_MouseLeftButtonUp" />
            <Image Name="DeleteImg" Source="{StaticResource DeleteIcon}" ToolTip="{x:Static p:Words.SpotRemove}" Cursor="Hand" Margin="1,0,1,0" Visibility="Collapsed" Width="{Binding IconSize}" MouseLeftButtonUp="Delete_MouseLeftButtonUp" />
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="1,0,1,0" />
            <Image Source="{StaticResource WhiteListIcon}" Margin="1,0,2,0" ToolTip="{Binding TooltipWhiteList}" Cursor="{Binding CursorWhiteList}" Width="{Binding IconSize}" Opacity="{Binding OpacityWhiteList}" MouseLeftButtonUp="WhiteList_MouseLeftButtonUp" />
            <Image Source="{StaticResource BlackListIcon}" Margin="2,0,-7,0" ToolTip="{Binding TooltipBlackList}" Cursor="{Binding CursorBlackList}" Width="{Binding IconSize}" Opacity="{Binding OpacityBlackList}" MouseLeftButtonUp="BlackList_MouseLeftButtonUp" />
          </DockPanel>
        </ToolBar>
      </ToolBarPanel>
    </DockPanel>
  </Grid>
</UserControl>