<UserControl x:Class="Spotnet.Controls.RemoteStatusTitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             VerticalAlignment="Center"
             Margin="0,0,6,0">
  <Button x:Name="TitleBarButton"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0"
          Padding="0"
          Cursor="Hand"
          Focusable="False"
          Click="TitleBarButton_Click">
    <Button.ToolTip>
      <ToolTip x:Name="StatusToolTip" Placement="Bottom">
        <StackPanel Orientation="Vertical" Margin="4">
          <TextBlock x:Name="TooltipTitle" Text="Spotnet Remote" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock x:Name="TooltipStatus" Text="Status: Controleren..." Margin="0,0,0,2"/>
          <TextBlock x:Name="TooltipClient" Text="" Margin="0,0,0,2" Visibility="Collapsed"/>
          <TextBlock x:Name="TooltipKeepAwake" Text="" Margin="0,0,0,4"/>
          <Border Height="1" Background="#30FFFFFF" Margin="0,2,0,4"/>
          <TextBlock Text="Klik om Spotnet Remote instellingen te openen" FontStyle="Italic" Opacity="0.8" FontSize="10"/>
        </StackPanel>
      </ToolTip>
    </Button.ToolTip>

    <Border x:Name="BadgeContainer"
            Background="#1E1E2E"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="11"
            Padding="7,2"
            SnapsToDevicePixels="True">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- LED Status Lampje (Groen = Aan, Blauw = In gebruik, Grijs = Uit) -->
        <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
          <Ellipse x:Name="StatusGlow" Fill="#10B981" Opacity="0.4" Margin="-2"/>
          <Ellipse x:Name="StatusLed" Fill="#10B981" Width="8" Height="8"/>
        </Grid>

        <!-- Status Tekst -->
        <TextBlock x:Name="StatusLabel"
                   Text="Remote: Aan"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0"/>

        <!-- In Gebruik Badge (Blauw) -->
        <Border x:Name="InUseBadge"
                Background="#2538BDF8"
                BorderBrush="#6038BDF8"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4,0"
                Margin="0,0,5,0"
                Visibility="Collapsed"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="📱 In gebruik"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#38BDF8"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Houd PC Wakker Badge (Koffiekopje / Wakker icoon) -->
        <Border x:Name="KeepAwakeBadge"
                Background="#25F59E0B"
                BorderBrush="#60F59E0B"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4,0"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="☕" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <TextBlock Text="Wakker"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#F59E0B"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Button>
</UserControl>
