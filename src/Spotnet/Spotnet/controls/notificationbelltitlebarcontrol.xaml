<UserControl x:Class="Spotnet.Controls.NotificationBellTitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             VerticalAlignment="Center"
             Margin="0,0,6,0">
  <Button x:Name="BellButton"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0"
          Padding="4,2"
          Cursor="Hand"
          Focusable="False"
          Click="BellButton_Click">
    <Button.ToolTip>
      <ToolTip x:Name="BellToolTip" Placement="Bottom">
        <StackPanel Orientation="Vertical" Margin="4">
          <TextBlock x:Name="TooltipTitle" Text="Spotnet Meldingen" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock x:Name="TooltipStatus" Text="Geen nieuwe meldingen" Margin="0,0,0,2"/>
          <Border Height="1" Background="#30FFFFFF" Margin="0,2,0,4"/>
          <TextBlock Text="Klik om meldingen te bekijken of te beheren" FontStyle="Italic" Opacity="0.8" FontSize="10"/>
        </StackPanel>
      </ToolTip>
    </Button.ToolTip>

    <Grid VerticalAlignment="Center">
      <!-- Bell Icon Background Glow (visible when unread > 0) -->
      <Ellipse x:Name="BellGlow" Width="20" Height="20" Fill="#F59E0B" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2"/>

      <!-- Bell Icon (FontAwesome \uf0f3 or Path) -->
      <Path x:Name="BellPath"
            Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
            Fill="#9CA3AF"
            Width="18"
            Height="18"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

      <!-- Unread Count Badge -->
      <Border x:Name="UnreadBadge"
              Background="#EF4444"
              BorderBrush="#FFFFFF"
              BorderThickness="1"
              CornerRadius="7"
              Padding="3,0"
              MinHeight="14"
              MinWidth="14"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="10,-5,-5,0"
              Visibility="Collapsed">
        <TextBlock x:Name="UnreadCountTextBlock"
                   Text="0"
                   FontSize="9"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </Button>
</UserControl>
