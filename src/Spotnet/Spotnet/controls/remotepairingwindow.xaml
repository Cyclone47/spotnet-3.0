<metro:MetroWindow x:Class="Spotnet.Controls.RemotePairingWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Spotnet.Localization"
                    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
                    Title="{loc:Loc PairTitle}"
                    Height="630" Width="490"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    ShowTitleBar="True"
                    ShowIconOnTitleBar="False"
                    GlowBrush="{DynamicResource HighlightBrush}"
                    Background="{DynamicResource DialogBackgroundBrush}"
                    WindowTitleBrush="{DynamicResource WindowTitleColorBrush}"
                    TitleForeground="{DynamicResource WindowTitleForegroundBrush}"
                    NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
      <TextBlock Text="{loc:Loc PairHeading}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
      <TextBlock Text="{loc:Loc PairSubHeading}" Opacity="0.8" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- QR Code & PIN Card -->
    <Border Grid.Row="1" Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Network Selector (Always visible to toggle between Wi-Fi and Cloudflare) -->
        <Border Background="{DynamicResource DialogBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
          <StackPanel Orientation="Vertical">
            <StackPanel Name="ConnectionModePanel" Orientation="Horizontal" HorizontalAlignment="Center">
              <RadioButton Name="LanModeRadio" Content="{loc:Loc PairModeLan}" FontWeight="SemiBold" Margin="0,0,16,0" Checked="ModeRadio_Checked" />
              <RadioButton Name="TunnelModeRadio" Content="{loc:Loc PairModeTunnel}" FontWeight="SemiBold" Checked="ModeRadio_Checked" />
            </StackPanel>
            <TextBlock Name="ConnectionModeHintTextBlock" Text="{loc:Loc PairModeLanHint}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Temporary Tunnel Warning Notice -->
        <Border Name="TunnelNoticeBanner" Background="#2A2010" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="{loc:Loc PairTunnelTemporary}" Foreground="#FCD34D" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <!-- Tunnel Connecting Notice (when opened while tunnel is starting up) -->
        <Border Name="TunnelConnectingBanner" Background="#1E293B" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Name="TunnelConnectingText" Text="{loc:Loc PairTunnelStarting}" Foreground="{DynamicResource HighlightBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <!-- QR Code Container with Loading Overlay -->
        <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
          <Border Name="QrCodeBorder" BorderThickness="4" BorderBrush="White" CornerRadius="8" Background="White">
            <Image Name="QrCodeImage" Width="185" Height="185" Stretch="Uniform" />
          </Border>

          <!-- Loading placeholder when tunnel is connecting -->
          <Border Name="QrLoadingOverlay" Width="193" Height="193" CornerRadius="8" Background="#F1F5F9" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="2" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
              <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6" />
              <TextBlock Name="QrLoadingText" Text="{loc:Loc PairTunnelConnecting}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" TextWrapping="Wrap" TextAlignment="Center" />
              <ProgressBar Name="QrLoadingProgressBar" IsIndeterminate="True" Height="4" Width="120" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="{loc:Loc PairEnterCodeManually}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,0,0,2" />
        <TextBlock Name="PinCodeTextBlock" Text="--- ---" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource HighlightBrush}" HorizontalAlignment="Center" />
        <TextBlock Name="ExpiryTextBlock" Text="{loc:Loc PairCodeValidFor}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,2,0,2" />
        <TextBlock Name="ActiveUrlTextBlock" Text="" FontSize="10" Opacity="0.5" TextAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380" />

        <Border Name="PairedSuccessBanner" Background="#10B981" CornerRadius="6" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock Name="PairedSuccessText" Text="{loc:Loc PairSucceeded}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Bottom Actions -->
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <Button Name="CopyLinkButton" Content="{loc:Loc PairCopyLink}" DockPanel.Dock="Left" Padding="12,6" Click="CopyLinkButton_Click" />
      <Button Name="CloseButton" Content="{loc:Loc Close}" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="90" Padding="12,6" IsDefault="True" Click="CloseButton_Click" />
    </DockPanel>
  </Grid>
</metro:MetroWindow>
