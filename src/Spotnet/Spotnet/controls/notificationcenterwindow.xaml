<metro:MetroWindow x:Class="Spotnet.Controls.NotificationCenterWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Spotnet.Localization"
                     xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
                     xmlns:notifications="clr-namespace:Spotnet.Notifications"
                     Title="{loc:Loc NcWindowTitle}"
                     Height="620" Width="720"
                     MinHeight="500" MinWidth="600"
                     WindowStartupLocation="CenterOwner"
                     ShowTitleBar="True"
                     ShowIconOnTitleBar="False"
                     GlowBrush="{DynamicResource HighlightBrush}"
                     Background="{DynamicResource DialogBackgroundBrush}"
                     WindowTitleBrush="{DynamicResource WindowTitleColorBrush}"
                     TitleForeground="{DynamicResource WindowTitleForegroundBrush}"
                     NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Main Tab Control -->
    <TabControl x:Name="MainTabControl" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BlackBrush}">
      <!-- TAB 1: RECENTE MELDINGEN -->
      <TabItem x:Name="NotificationsTab" Header="{loc:Loc NcTabNotifications}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BlackBrush}">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Expander Grid.Row="0" Header="{loc:Loc NcHistoryHeader}" Margin="0,0,0,10" IsExpanded="True">
            <StackPanel Margin="4,8,4,0">
              <TextBlock Text="{loc:Loc NcHistoryIntro}" TextWrapping="Wrap" FontWeight="Normal" FontSize="12" Margin="0,0,0,8" />
              <UniformGrid x:Name="HistoryChoices" Columns="2">
                <CheckBox Content="{loc:Loc NcHistoryDownloadFinished}" Tag="{x:Static notifications:NotificationHistoryType.DownloadFinished}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
                <CheckBox Content="{loc:Loc NcHistoryDownloadFailed}" Tag="{x:Static notifications:NotificationHistoryType.DownloadFailed}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
                <CheckBox Content="{loc:Loc NcHistoryDownloadPassword}" Tag="{x:Static notifications:NotificationHistoryType.DownloadPasswordRequired}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
                <CheckBox Content="{loc:Loc NcHistoryDownloadWarning}" Tag="{x:Static notifications:NotificationHistoryType.DownloadWarning}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
                <CheckBox Content="{loc:Loc NcHistoryFilterRules}" Tag="{x:Static notifications:NotificationHistoryType.Filter}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
                <CheckBox Content="{loc:Loc NcHistoryKeywordRules}" Tag="{x:Static notifications:NotificationHistoryType.Keyword}" Margin="0,0,8,6" Click="HistoryChoice_Click" />
              </UniformGrid>
            </StackPanel>
          </Expander>

          <!-- Action Bar -->
          <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="NotificationsHeaderTextBlock" Text="{loc:Loc NcRecent}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
              <Button x:Name="MarkAllReadButton" Content="{loc:Loc NcMarkAllRead}" Padding="8,4" Margin="0,0,8,0" Click="MarkAllReadButton_Click" />
              <Button x:Name="ClearAllButton" Content="{loc:Loc NcClearAll}" Padding="8,4" Click="ClearAllButton_Click" />
            </StackPanel>
          </DockPanel>

          <!-- Empty State -->
          <Border x:Name="EmptyNotificationsPanel" Grid.Row="2" Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="8" Padding="20" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="🔔" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5" />
              <TextBlock Text="{loc:Loc NcEmptyTitle}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Loc NcEmptyHint}" Opacity="0.75" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
            </StackPanel>
          </Border>

          <!-- Notifications List -->
          <ListBox x:Name="NotificationsListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Background="{DynamicResource DialogPanelBackgroundBrush}" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Badge, Title, Time, Delete Button -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                      <Border CornerRadius="4" Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding RuleName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}" />
                      </Border>
                      <Button Content="✕" DockPanel.Dock="Right" Padding="4,0" Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand" Click="DeleteNotification_Click" Tag="{Binding Id}" />
                      <TextBlock Text="{Binding TimeAgo}" FontSize="11" Opacity="0.6" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Message Body -->
                    <TextBlock Grid.Row="1" Text="{Binding Body}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Clickable Spots Items -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Spots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Margin="0,2,0,2" Padding="8,4" Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" HorizontalContentAlignment="Left" Cursor="Hand" Click="OpenSpotButton_Click" Tag="{Binding}">
                            <DockPanel>
                              <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="11" Width="70" DockPanel.Dock="Left" Foreground="{DynamicResource HighlightBrush}" />
                              <TextBlock Text="{Binding FormattedSize}" FontSize="11" Opacity="0.6" Width="65" DockPanel.Dock="Right" TextAlignment="Right" />
                              <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,0,8,0" />
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <!-- TAB 2: REGELS BEHEREN & NIEUWE MELDING -->
      <TabItem x:Name="RulesTab" Header="{loc:Loc NcTabRules}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BlackBrush}">
        <ScrollViewer x:Name="RulesTabScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel Orientation="Vertical">
            <!-- Section 1: Nieuwe Melding Aanmaken Card -->
            <Border Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1">
              <StackPanel Orientation="Vertical">
                <TextBlock x:Name="RuleFormHeaderTextBlock" Text="{loc:Loc NcNewRule}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

                <!-- Rule Type Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <RadioButton x:Name="RuleTypeFilterRadio" Content="{loc:Loc NcRuleTypeFilter}" IsChecked="True" FontWeight="SemiBold" Margin="0,0,16,0" Checked="RuleTypeRadio_Checked" />
                  <RadioButton x:Name="RuleTypeKeywordRadio" Content="{loc:Loc NcRuleTypeKeyword}" FontWeight="SemiBold" Checked="RuleTypeRadio_Checked" />
                </StackPanel>

                <!-- Name Field -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="{loc:Loc NcRuleName}" Width="140" VerticalAlignment="Center" />
                  <TextBox x:Name="RuleNameTextBox" Width="260" VerticalAlignment="Center" />
                </StackPanel>

                <!-- FILTER OPTIONS PANEL -->
                <StackPanel x:Name="FilterOptionsPanel" Orientation="Vertical">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc NcSelectFilter}" Width="140" VerticalAlignment="Center" />
                    <ComboBox x:Name="FilterComboBox" Width="260" VerticalAlignment="Center" DisplayMemberPath="Name" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc NcCheckEvery}" Width="140" VerticalAlignment="Center" />
                    <ComboBox x:Name="FilterIntervalComboBox" Width="160" VerticalAlignment="Center" SelectionChanged="FilterIntervalComboBox_SelectionChanged">
                      <ComboBoxItem Content="{loc:Loc NcEvery15Minutes}" Tag="15" IsSelected="True" />
                      <ComboBoxItem Content="{loc:Loc NcEvery30Minutes}" Tag="30" />
                      <ComboBoxItem Content="{loc:Loc NcEvery1Hour}" Tag="60" />
                      <ComboBoxItem Content="{loc:Loc NcEvery8Hours}" Tag="480" />
                      <ComboBoxItem Content="{loc:Loc NcEvery24Hours}" Tag="1440" />
                      <ComboBoxItem Content="{loc:Loc NcCustomInterval}" Tag="-1" />
                    </ComboBox>
                    <TextBox x:Name="CustomIntervalTextBox" Width="60" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{loc:Loc NcCustomIntervalTip}" Text="45" />
                    <TextBlock x:Name="CustomIntervalMinLabel" Text="{loc:Loc NcMinutes}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                  </StackPanel>
                </StackPanel>

                <!-- KEYWORD OPTIONS PANEL -->
                <StackPanel x:Name="KeywordOptionsPanel" Orientation="Vertical" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc NcKeywords}" Width="140" VerticalAlignment="Center" />
                    <TextBox x:Name="KeywordsTextBox" Width="260" VerticalAlignment="Center" ToolTip="{loc:Loc NcKeywordsTip}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc NcCategory}" Width="140" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeywordCategoryComboBox" Width="260" VerticalAlignment="Center">
                      <ComboBoxItem Content="{loc:Loc NcAllCategories}" Tag="0" IsSelected="True" />
                      <ComboBoxItem Content="{loc:Loc NcCatFilms}" Tag="1" />
                      <ComboBoxItem Content="{loc:Loc NcCatSeries}" Tag="6" />
                      <ComboBoxItem Content="{loc:Loc NcCatMusic}" Tag="2" />
                      <ComboBoxItem Content="{loc:Loc NcCatGames}" Tag="3" />
                      <ComboBoxItem Content="{loc:Loc NcCatApplications}" Tag="4" />
                      <ComboBoxItem Content="{loc:Loc NcCatBooks}" Tag="5" />
                      <ComboBoxItem Content="{loc:Loc NcCatErotica}" Tag="9" />
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc NcCheckMode}" Width="140" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="KeywordDirectRadio" Content="{loc:Loc NcCheckDirect}" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
                      <RadioButton x:Name="KeywordPeriodicRadio" Content="{loc:Loc NcCheckPeriodic}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- Usenet Sync Interval Setting -->
                <Border BorderThickness="1" BorderBrush="#30FFFFFF" Background="#10FFFFFF" CornerRadius="4" Padding="8" Margin="0,4,0,12">
                  <DockPanel>
                    <TextBlock Text="{loc:Loc NcAutoSyncInterval}" VerticalAlignment="Center" DockPanel.Dock="Left" FontSize="11" />
                    <ComboBox x:Name="AutoSyncIntervalComboBox" Width="130" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectionChanged="AutoSyncIntervalComboBox_SelectionChanged">
                      <ComboBoxItem Content="{loc:Loc NcSyncEvery5}" Tag="5" />
                      <ComboBoxItem Content="{loc:Loc NcSyncEvery10}" Tag="10" />
                      <ComboBoxItem Content="{loc:Loc NcSyncEvery15}" Tag="15" IsSelected="True" />
                      <ComboBoxItem Content="{loc:Loc NcSyncEvery30}" Tag="30" />
                      <ComboBoxItem Content="{loc:Loc NcSyncEvery60}" Tag="60" />
                    </ComboBox>
                  </DockPanel>
                </Border>

                <!-- Windows Notifications Setting -->
                <CheckBox x:Name="WindowsNotificationsCheckBox" Content="{loc:Loc NcWindowsToasts}" IsChecked="True" Margin="0,0,0,12" Click="WindowsNotificationsCheckBox_Click" />

                <!-- Submit and Cancel Buttons -->
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SaveRuleButton" Content="{loc:Loc NcSaveRule}" FontWeight="Bold" Padding="14,6" HorizontalAlignment="Left" Click="SaveRuleButton_Click" />
                  <Button x:Name="CancelEditRuleButton" Content="{loc:Loc Cancel}" Padding="14,6" Margin="10,0,0,0" HorizontalAlignment="Left" Click="CancelEditRuleButton_Click" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Section 2: Bestaande Meldingen List -->
            <TextBlock Text="{loc:Loc NcActiveRules}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
            <ListBox x:Name="RulesListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Background="{DynamicResource DialogPanelBackgroundBrush}" BorderThickness="1" BorderBrush="#30FFFFFF" Padding="10" Margin="0,0,0,6">
                    <DockPanel>
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="{loc:Loc NcEditRule}" Padding="6,3" Margin="0,0,6,0" Cursor="Hand" Click="EditRule_Click" Tag="{Binding Id}" ToolTip="{loc:Loc NcEditRuleTip}" />
                        <Button Content="{loc:Loc NcTestRule}" Padding="6,3" Margin="0,0,6,0" Cursor="Hand" Click="TestRule_Click" Tag="{Binding Id}" ToolTip="{loc:Loc NcTestRuleTip}" />
                        <Button Content="🗑" Padding="6,3" Cursor="Hand" Click="DeleteRule_Click" Tag="{Binding Id}" ToolTip="{loc:Loc NcDeleteRuleTip}" />
                      </StackPanel>

                      <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left" Click="ToggleRule_Click" Tag="{Binding Id}" />

                      <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                          <Border CornerRadius="3" Background="#2038BDF8" Padding="4,0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding IntervalDescription}" FontSize="10" Foreground="{DynamicResource HighlightBrush}" />
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="11" Opacity="0.7">
                          <Run Text="{loc:Loc NcFilterOrKeyword}" />
                          <Run Text="{Binding FilterName}" />
                          <Run Text="{Binding Keywords}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Bottom Close Button -->
    <Button Grid.Row="1" Content="{loc:Loc Close}" Width="90" HorizontalAlignment="Right" Padding="10,4" Margin="0,10,0,0" Click="CloseButton_Click" IsDefault="True" />
  </Grid>
</metro:MetroWindow>
