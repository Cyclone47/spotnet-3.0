<UserControl x:Class="Spotnet.Controls.SettingsForIntegrations"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Spotnet.Localization"
             FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="150" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="FieldRow" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,3,0,3" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="150,2,0,0" />
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Vertical" Margin="4">
    <TextBlock Text="{loc:Loc IntegrTitle}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
    <TextBlock Text="{loc:Loc IntegrIntro}"
               TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12" />

    <!-- Newznab -->
    <Border Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
      <StackPanel Orientation="Vertical">
        <DockPanel LastChildFill="False" Margin="0,0,0,6">
          <TextBlock DockPanel.Dock="Left" Text="{loc:Loc IntegrNewznabHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Name="NewznabStatusTextBlock" DockPanel.Dock="Right" Text="{loc:Loc IntegrDisabled}"
                     Opacity="0.75" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{loc:Loc IntegrNewznabHint}"
                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
        <StackPanel Style="{StaticResource FieldRow}">
          <TextBlock Text="{loc:Loc IntegrServerLabel}" Style="{StaticResource FieldLabel}" />
          <TextBox Name="NewznabUrlTextBox" Width="420" TextChanged="Field_Changed" />
        </StackPanel>
        <TextBlock Text="{loc:Loc IntegrServerHint}"
                   Style="{StaticResource Hint}" />
        <StackPanel Style="{StaticResource FieldRow}">
          <TextBlock Text="{loc:Loc IntegrApiKeyLabel}" Style="{StaticResource FieldLabel}" />
          <TextBox Name="NewznabKeyTextBox" Width="300" IsReadOnly="True" TextChanged="Field_Changed" />
          <Button Name="ReplaceNewznabKeyButton" Content="{loc:Loc IntegrReplace}" Margin="10,0,0,0" Padding="10,2"
                  Click="ReplaceNewznabKeyButton_Click" />
        </StackPanel>
        <TextBlock Text="{loc:Loc IntegrKeyMaskedHint}"
                   Style="{StaticResource Hint}" />
      </StackPanel>
    </Border>

    <!-- OMDb -->
    <Border Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
      <StackPanel Orientation="Vertical">
        <DockPanel LastChildFill="False" Margin="0,0,0,6">
          <TextBlock DockPanel.Dock="Left" Text="{loc:Loc IntegrOmdbHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Name="OmdbStatusTextBlock" DockPanel.Dock="Right" Text="{loc:Loc IntegrDisabled}"
                     Opacity="0.75" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{loc:Loc IntegrOmdbHint}"
                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
        <StackPanel Style="{StaticResource FieldRow}">
          <TextBlock Text="{loc:Loc IntegrApiKeyLabel}" Style="{StaticResource FieldLabel}" />
          <TextBox Name="OmdbKeyTextBox" Width="300" IsReadOnly="True" TextChanged="Field_Changed" />
          <Button Name="ReplaceOmdbKeyButton" Content="{loc:Loc IntegrReplace}" Margin="10,0,0,0" Padding="10,2"
                  Click="ReplaceOmdbKeyButton_Click" />
        </StackPanel>
        <TextBlock Text="{loc:Loc IntegrOmdbKeyHint}"
                   Style="{StaticResource Hint}" />
      </StackPanel>
    </Border>

    <TextBlock Name="ValidationTextBlock" Text="" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,6,0,0" />
  </StackPanel>
</UserControl>
