<UserControl x:Class="Spotnet.Controls.SettingsForTabs" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Spotnet.Localization" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Orientation="Vertical">
    <CheckBox Name="SetTabs" Content="{loc:Loc MenuRememberTabs}" Margin="0,7,0,0" />
    <Separator Margin="10,10,10,3" />
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <TextBlock Text="{loc:Loc SelectTheme}" />
      <ComboBox Name="TabThemeCombo" SelectionChanged="TabThemeCombo_OnSelectionChanged" />
    </StackPanel>
    <CheckBox Name="ShowTabToolbar" Content="{loc:Loc MenuShowTabToolbar}" Margin="0,7,0,0" />
    <Separator Margin="10,10,10,3" />
    <CheckBox Name="UseExternalBrowser" Content="{loc:Loc MenuUseExternalBrowser}" Margin="0,7,0,0" />
    <CheckBox Name="DoNotLoadImageOnSpotTab" Content="{loc:Loc MenuDoNotLoadImageOnSpotTab}" Margin="0,7,0,0" />
    <CheckBox Name="ShowCom" Content="{loc:Loc MenuAutoGetComments}" Margin="0,7,0,0" />
    <Separator Margin="10,10,10,3" />
    <CheckBox Name="EnableSmiles" Content="{loc:Loc MenuEnableSmiles}" Margin="0,7,0,0" />
    <Grid Margin="0,7,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Name="AvatarImage" Grid.Column="0" Margin="0,0,10,0" Width="32" Height="32" />
      <Button Grid.Column="1" Content="{loc:Loc ChangeAvatar}" Margin="0,0,10,0" Width="110" VerticalAlignment="Center" Click="ChangeAvatar_OnClick" />
      <Button Grid.Column="2" Content="{loc:Loc ResetAvatar}" Margin="0,0,10,0" Width="110" VerticalAlignment="Center" Click="ResetAvatar_OnClick" />
    </Grid>
  </StackPanel>
</UserControl>