<metro:MetroWindow x:Class="Spotnet.Controls.RemotePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Spotnet.Localization"
    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
    Title="{loc:Loc RemotePasswordWindowTitle}" Width="430" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    ShowIconOnTitleBar="False" Background="{DynamicResource DialogBackgroundBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="{loc:Loc RemotePasswordIntro}" TextWrapping="Wrap" Margin="0,0,0,18" />
    <TextBlock Text="{loc:Loc RemotePasswordLabel}" Margin="0,0,0,6" />
    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" />
    <TextBlock Text="{loc:Loc RemotePasswordRepeat}" Margin="0,0,0,6" />
    <PasswordBox x:Name="ConfirmInput" Margin="0,0,0,12" />
    <TextBlock x:Name="ErrorText" Foreground="#D32F2F" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Loc Ok}" IsDefault="True" MinWidth="85" Margin="0,0,8,0" Click="Confirm_Click" />
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="85" />
    </StackPanel>
  </StackPanel>
</metro:MetroWindow>
