<metro:MetroWindow x:Class="Spotnet.Controls.ComplainToTheSpot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Title="{x:Static p:Words.ComplainToSpot}" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <Grid Name="MainGrid" Margin="20,20,20,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Words.ColumnSubject}" FontWeight="Bold" />
    <Label Name="LabelForTitle" Grid.Row="0" Grid.Column="1" Content="Test" />
    <Label Grid.Row="1" Grid.Column="0" Content="{x:Static p:Words.ColumnSender}" FontWeight="Bold" />
    <Label Name="LabelForPoster" Grid.Row="1" Grid.Column="1" Content="Test" />
    <Label Name="BodyText" Grid.Row="2" Grid.ColumnSpan="2" Content="{x:Static p:Words.WhySpotShouldBeRemoved}" Margin="0,10,0,0" />
    <TextBox Name="ComplainTextBox" Grid.Row="3" Grid.ColumnSpan="2" />
    <CheckBox Name="AddToBlacklistCheckBox" Grid.Row="4" Content="{x:Static p:Words.IncludePosterToBlacklist}" Margin="0,10" IsChecked="True" />
    <Grid Row="5" ColumnSpan="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="OkButton" Grid.Column="1" Content="OK" Margin="10,0" IsEnabled="False" Click="OkButton_OnClick" />
      <Button Name="CancelButton" Grid.Column="2" Content="Cancel" Click="CancelButton_OnClick" />
    </Grid>
  </Grid>
</metro:MetroWindow>