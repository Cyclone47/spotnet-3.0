<metro:MetroWindow x:Class="Spotnet.Controls.AdvancedMessageBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Width="450" Height="200" Title="MessageBox" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources\ImagesInternal\smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Grid x:Key="ServerStatusInProgress" Margin="10,1,10,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Visible" Width="280">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="ServerStatusInProgressTextBlock" Grid.Column="0" Margin="0,3,10,0" Text="Server status" TextWrapping="Wrap" Width="170" />
        <controls:ProgressRing Grid.Column="1" IsActive="True" Height="15" Width="15" Margin="0,3,10,5" />
      </Grid>
      <Grid x:Key="ServerStatusAvailable" Margin="10,1,10,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Visible" Width="280">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="ServerStatusAvailableTextBlock" Grid.Column="0" Margin="0,3,10,0" Text="Server status" TextWrapping="Wrap" Width="170" />
        <Image Grid.Column="1" Source="/Resources\ImagesInternal\success.ico" Width="15" Margin="0,5,10,5" />
        <Button Grid.Column="2" Content="{x:Static p:Words.Connect}" Padding="5,0" Height="23" Click="ConnectButton_OnClick" />
      </Grid>
      <Grid x:Key="ServerStatusNotAvailable" Margin="10,1,10,1" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Visible" Width="280">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="ServerStatusNotAvailableTextBlock" Grid.Column="0" Margin="0,3,10,0" Text="Server status" TextWrapping="Wrap" Width="170" />
        <Image Grid.Column="1" Source="/Resources\ImagesInternal\delete.ico" Width="15" Margin="0,5,10,5" />
      </Grid>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="50" />
    </Grid.RowDefinitions>
    <TextBlock Name="ContentLabel" TextAlignment="Center" Margin="20,30,20,5" Grid.Row="0" VerticalAlignment="Top" Text="Content label" TextWrapping="Wrap" />
    <Grid Name="ServersStatus" Margin="20,5,20,5" Row="1" VerticalAlignment="Top" Visibility="Visible" />
    <Button Name="OKButton" Content="OK" Grid.Row="2" Height="31" Width="124" Click="OKButton_Click" />
  </Grid>
</metro:MetroWindow>