<metro:MetroWindow x:Class="Spotnet.Controls.ChangeSpotThemeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.MenuSpotsThemeChange}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <DockPanel FocusManager.FocusedElement="{Binding ElementName=TabThemeCombo}">
    <StackPanel Orientation="Vertical" Margin="20,7,20,0" DockPanel.Dock="Top">
      <TextBlock Text="{x:Static p:Words.SelectTheme}" Margin="0,5,0,5" HorizontalAlignment="Left" />
      <ComboBox Name="TabThemeCombo" MinWidth="150" TabIndex="1" SelectionChanged="TabThemeCombo_OnSelectionChanged" />
    </StackPanel>
    <CheckBox Name="ShowTabToolbar" DockPanel.Dock="Top" Content="{x:Static p:Words.MenuShowTabToolbar}" TabIndex="2" Margin="20,7,20,0" />
    <DockPanel Dock="Bottom" Margin="20,0,20,10" HorizontalAlignment="Right">
      <Button Name="OkButton" Width="124" Height="30" IsDefault="True" Content="{x:Static p:Words.Ok}" TabIndex="7" Margin="10,10,10,0" Click="OkButton_Click" />
      <Button Name="CancelButton" Width="124" Height="30" IsEnabled="True" Content="{x:Static p:Words.Cancel}" TabIndex="8" Margin="10,10,0,0" Click="CancelButton_Click" />
    </DockPanel>
  </DockPanel>
</metro:MetroWindow>