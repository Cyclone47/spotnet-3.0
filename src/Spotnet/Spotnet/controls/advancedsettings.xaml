<metro:MetroWindow x:Class="Spotnet.Controls.AdvancedSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" xmlns:p="clr-namespace:Spotnet.Properties" Title="{x:Static p:Words.AdvancedSettings}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" SizeToContent="Manual" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" Height="500" Width="680" WindowTransitionsEnabled="True" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ListBox Name="SettingsHeadersListBox" Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch" BorderThickness="1" Margin="10,10,10,0" Background="{DynamicResource DialogPanelBackgroundBrush}" FontSize="{DynamicResource WindowTitleFontSize}" Width="180" ItemsSource="{Binding SettingHeaders}" SelectedIndex="{Binding HeaderItemIndex}" />
    <Grid Margin="5,10,10,0" Column="1" Row="0" VerticalAlignment="Stretch">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,1">
        <Grid Name="ContentGrid" />
      </ScrollViewer>
      <Separator VerticalAlignment="Bottom" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" Grid.Column="1" Grid.Row="1">
      <Button Name="SaveButton" Margin="5" Content="{x:Static p:Words.Save}" Height="25" Width="90" HorizontalAlignment="Right" IsDefault="False" IsEnabled="True" Click="SaveButton_Click" />
      <Button Name="OkButton" Margin="5" Content="{x:Static p:Words.Ok}" Height="25" Width="90" HorizontalAlignment="Right" IsDefault="False" IsEnabled="True" Click="OkButton_Click" />
      <Button Name="CancelButton" Margin="5" Content="{x:Static p:Words.Cancel}" Height="25" Width="90" HorizontalAlignment="Right" IsDefault="False" IsEnabled="True" Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</metro:MetroWindow>