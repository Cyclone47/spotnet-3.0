<MenuItem x:Class="Spotnet.Controls.SpotsListTypeMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Spotnet.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:p="clr-namespace:Spotnet.Properties" x:Name="SpotsListTypeMenuItem" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Header="{loc:Loc MenuSpotsListType}" xmlns:controls="clr-namespace:Spotnet.Controls" DataContext="{Binding SpotsList, Source={StaticResource Locator}}">
  <MenuItem.Style><DynamicResource ResourceKey="SpotnetMenuItemStyle" /></MenuItem.Style>
  <MenuItem.Icon>
    <TextBlock Text="" Style="{StaticResource FontAwesomeMenuPics}" />
  </MenuItem.Icon>
  <MenuItem Name="SpotsListNoDetails" Tag="SpotsListNoDetails" Header="{loc:Loc MenuSpotsListNoDetails}" IsCheckable="True" IsChecked="{Binding SpotsListNoDetails, Mode=OneWay}" Click="SpotsListNoDetails_Click" />
  <MenuItem Name="SpotsListWithDetails" Tag="SpotsListWithDetails" Header="{loc:Loc MenuSpotsListDetails}" IsCheckable="True" IsChecked="{Binding SpotsListWithDetails, Mode=OneWay}" Click="SpotsListWithDetails_Click" />
  <MenuItem Name="SpotsListPicsOnly" Tag="SpotsListPicsOnly" Header="{loc:Loc MenuSpotsListPics}" IsCheckable="True" IsChecked="{Binding SpotsListPicsOnly, Mode=OneWay}" Click="SpotsListPicsOnly_Click" />
</MenuItem>
