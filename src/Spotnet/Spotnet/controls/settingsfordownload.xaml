<UserControl x:Class="Spotnet.Controls.SettingsForDownload" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Spotnet.Localization" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:viewModel="clr-namespace:Spotnet.ViewModel" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Orientation="Vertical">
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <TextBlock Text="{loc:Loc SelectDownloadsFolder}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="DownloadFolderTextBox" Grid.Column="0" GotFocus="DownloadFolderTextBox_OnGotFocus" TextChanged="DownloadFolderTextBox_OnTextChanged" />
        <Button Grid.Column="1" Margin="5,0,0,0" Content="{loc:Loc Browse}" Click="BrowseDownloaderPath_OnClick" />
      </Grid>
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <CheckBox Name="EnableScheduleCheckBox" Content="{loc:Loc DownloaderScheduleText}" Click="EnableScheduleCheckBox_OnClick" />
      <StackPanel Orientation="Horizontal" Margin="25,0">
        <Border Name="DownloaderScheduleStartTimeTextBoxBorder" BorderBrush="#00FFFFFF" BorderThickness="2">
          <TextBox Name="DownloaderScheduleStartTime" TabIndex="2" Text="00:00" MaxLength="5" Width="52" TextAlignment="Center" IsEnabled="False" GotFocus="DownloaderScheduleTime_GotFocus" TextChanged="DownloaderScheduleOnTimeChanged" />
        </Border>
        <TextBlock Text=" - " />
        <Border Name="DownloaderScheduleEndTimeTextBoxBorder" BorderBrush="#00FFFFFF" BorderThickness="2">
          <TextBox Name="DownloaderScheduleEndTime" TabIndex="2" Text="00:00" MaxLength="5" Width="52" TextAlignment="Center" IsEnabled="False" GotFocus="DownloaderScheduleTime_GotFocus" TextChanged="DownloaderScheduleOnTimeChanged" />
        </Border>
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <CheckBox Name="SpeedLimitCheckBox" Content="{loc:Loc SpeedLimit}" Click="SpeedLimitCheckBox_OnClick" />
      <Border Name="SpeedLimitTextBoxBorder" BorderBrush="#00FFFFFF" HorizontalAlignment="Left" Margin="25,0" BorderThickness="2">
        <TextBox Name="SpeedLimitTextBox" TabIndex="2" ToolTip="{loc:Loc SpeedLimit}" Width="50" GotFocus="SpeedLimit_GotFocus" TextChanged="SpeedLimitTextBox_OnTextChanged" />
      </Border>
    </StackPanel>
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <TextBlock Text="{loc:Loc MenuRemoveFilesOnDownloadRemove}" />
      <ComboBox Name="RemoveFilesCombo">
        <TextBlock Text="{loc:Loc YesWord}" />
        <TextBlock Text="{loc:Loc NoWord}" />
        <TextBlock Text="{loc:Loc Ask}" />
      </ComboBox>
    </StackPanel>
    <CheckBox Name="RemovePar2Files" Content="{loc:Loc RemovePar2Files}" Margin="0,7,0,0" />
    <CheckBox Name="ShutdownPcAfterDownloads" Content="{loc:Loc MenuShutdownPCAfterDownloads}" Margin="0,7,0,0" />
    <CheckBox Name="NotifyAboutDownloadComplete" Content="{loc:Loc MenuNotifyAboutDownloadComplete}" Margin="0,7,0,0" />
    <StackPanel Name="CleanupPanel" Margin="0,18,0,0">
      <TextBlock Text="{loc:Loc CleanupHeader}" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Loc CleanupIntro}" TextWrapping="Wrap" Margin="0,5,0,8" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="CleanupExtensionInput" ToolTip="{loc:Loc CleanupExtensionTip}" KeyDown="CleanupExtensionInput_OnKeyDown" />
        <Button Grid.Column="1" Content="{loc:Loc CleanupAdd}" Click="CleanupAdd_OnClick" Margin="6,0,0,0" />
      </Grid>
      <TextBlock Name="CleanupError" TextWrapping="Wrap" Foreground="{DynamicResource NoticeForegroundBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
      <ListBox Name="CleanupExtensionsList" Height="110" Margin="0,6,0,6" SelectionMode="Extended" />
      <WrapPanel>
        <Button Content="{loc:Loc CleanupRemove}" Click="CleanupRemove_OnClick" Margin="0,0,6,0" />
        <Button Content="{loc:Loc CleanupAddSuggestions}" Click="CleanupSuggestions_OnClick" />
      </WrapPanel>
      <TextBlock Text="{loc:Loc CleanupSuggestions}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock Name="CleanupExternalNotice" Text="{loc:Loc CleanupExternalNzbGet}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </StackPanel>
</UserControl>
