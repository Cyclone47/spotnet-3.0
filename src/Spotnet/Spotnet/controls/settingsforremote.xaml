<UserControl x:Class="Spotnet.Controls.SettingsForRemote"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Spotnet.Localization"
             xmlns:p="clr-namespace:Spotnet.Properties"
             FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <StackPanel Orientation="Vertical" Margin="4">
    <TextBlock Text="{loc:Loc RemoteTitle}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
    <TextBlock Text="{loc:Loc RemoteIntro}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12" />

    <CheckBox Name="EnableRemoteCheckBox" Content="{loc:Loc RemoteEnable}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,10" Click="EnableRemoteCheckBox_Click" />

    <Border Name="RemoteConfigPanel" BorderBrush="{DynamicResource DialogPanelBackgroundBrush}" BorderThickness="1" Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
      <StackPanel Orientation="Vertical">
        <!-- Quick Connect & Status Banner -->
        <Border Background="{DynamicResource DialogBackgroundBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:Loc RemoteStatusLabel}" FontWeight="SemiBold" />
                <TextBlock Name="ServerStatusTextBlock" Text="{loc:Loc RemoteStopped}" Foreground="LightGray" FontWeight="Bold" />
              </StackPanel>
              <TextBlock Name="ServerUrlTextBlock" Text="http://127.0.0.1:8770" Opacity="0.7" FontSize="11" />
            </StackPanel>

            <Button Name="PairDeviceButton" Content="{loc:Loc RemoteShowQrCode}" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13" Padding="16,8" VerticalAlignment="Center" Click="PairDeviceButton_Click" />
          </DockPanel>
        </Border>

        <!-- Simpele Verbindingsopties -->
        <TextBlock Text="{loc:Loc RemoteConnectionOptions}" FontWeight="SemiBold" Margin="0,2,0,6" />
        
        <CheckBox Name="AllowLanCheckBox" Content="{loc:Loc RemoteAllowLan}" Margin="0,4,0,8" Click="AllowLanCheckBox_Click" />

        <CheckBox Name="EnableCloudflareTunnelCheckBox" Content="{loc:Loc RemoteEnableCloudflare}" FontWeight="SemiBold" Margin="0,4,0,2" Click="EnableCloudflareTunnelCheckBox_Click" />
        <TextBlock Text="{loc:Loc RemoteCloudflareHint}" Opacity="0.7" FontSize="11" Margin="22,0,0,4" TextWrapping="Wrap" />

        <!-- Cloudflare Quick Status (Compact) -->
        <StackPanel Name="CloudflareTunnelPanel" Margin="22,0,0,8" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
            <TextBlock Text="{loc:Loc RemoteCloudflareStatusLabel}" FontSize="11" Opacity="0.8" />
            <TextBlock Name="CloudflareStatusTextBlock" Text="{loc:Loc RemoteStopped}" FontSize="11" FontWeight="SemiBold" Foreground="LightGray" />
          </StackPanel>
          <ProgressBar Name="CloudflareDownloadProgressBar" Height="4" Margin="0,3,40,3" Visibility="Collapsed" Minimum="0" Maximum="100" />
          <StackPanel Name="CloudflareUrlRow" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc RemoteCloudflareUrlLabel}" FontSize="11" Opacity="0.8" />
            <TextBox Name="CloudflareUrlTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource HighlightBrush}" FontWeight="Bold" FontSize="11" Text="" />
          </StackPanel>
        </StackPanel>

        <!-- Geavanceerde Instellingen (Inklapbaar zodat simpele gebruikers er geen last van hebben) -->
        <Expander Header="{loc:Loc RemoteAdvancedHeader}" Margin="0,8,0,4">
          <Border Background="{DynamicResource DialogBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,4,0,0">
            <StackPanel Orientation="Vertical">
              <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                <TextBlock Name="PortLabel" Text="{loc:Loc RemotePortLabel}" Width="110" VerticalAlignment="Center" />
                <TextBox Name="PortTextBox" Text="8770" Width="70" VerticalAlignment="Center" LostFocus="PortTextBox_LostFocus" />
                <Button Name="OpenBrowserButton" Content="{loc:Loc RemoteOpenInBrowser}" Margin="14,0,0,0" Padding="8,2" Click="OpenBrowserButton_Click" />
              </StackPanel>

              <CheckBox Name="RequireAuthCheckBox" Content="{loc:Loc RemoteRequireAuth}" FontWeight="SemiBold" IsChecked="True" Margin="0,4,0,4" Click="RequireAuthCheckBox_Click" />
              <StackPanel Name="AuthCredentialsPanel" Orientation="Horizontal" Margin="22,2,0,6">
                <TextBlock Name="AuthPasswordHintTextBlock" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" />
                <Button Name="ChangePasswordButton" Content="{loc:Loc RemoteSetPassword}" Padding="8,2" FontSize="11" Click="ChangePasswordButton_Click" />
              </StackPanel>

              <TextBlock Name="NoAuthWarningTextBlock" Text="{loc:Loc RemoteNoAuthWarning}" Foreground="#F59E0B" FontSize="11" Margin="22,0,0,6" Visibility="Collapsed" />

              <CheckBox Name="KeepAwakeCheckBox" Content="{loc:Loc RemoteKeepAwake}" Margin="0,4,0,2" Click="KeepAwakeCheckBox_Click" />
            </StackPanel>
          </Border>
        </Expander>

      </StackPanel>
    </Border>

    <!-- Gekoppelde apparaten -->
    <TextBlock Text="{loc:Loc RemotePairedDevices}" FontWeight="SemiBold" Margin="0,4,0,6" />
    <ListBox Name="PairedDevicesListBox" Height="130" BorderThickness="1" Background="{DynamicResource DialogBackgroundBrush}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,2">
            <Button Content="{loc:Loc RemoteRevoke}" DockPanel.Dock="Right" Padding="8,2" Margin="10,0,0,0" Click="RevokeDevice_Click" Tag="{Binding Id}" />
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" />
              <TextBlock Opacity="0.7" FontSize="11">
                <Run Text="{loc:Loc RemotePairedAt}" />
                <Run Text="{Binding PairedAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" />
                <Run Text="{loc:Loc RemoteLastSeen}" />
                <Run Text="{Binding LastSeenAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" />
                <Run Text=" (" />
                <Run Text="{Binding IpAddress}" />
                <Run Text=")" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Name="RevokeAllButton" Content="{loc:Loc RemoteRevokeAll}" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="8,3" Click="RevokeAllButton_Click" />
  </StackPanel>
</UserControl>
