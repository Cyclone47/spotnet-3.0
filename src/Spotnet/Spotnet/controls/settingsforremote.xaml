<UserControl x:Class="Spotnet.Controls.SettingsForRemote"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Spotnet.Properties"
             FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <StackPanel Orientation="Vertical" Margin="4">
    <TextBlock Text="Spotnet Remote (Mobiele Companion)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
    <TextBlock Text="Bedien Spotnet via je smartphone of tablet binnen je thuisnetwerk. Zoek spots, bekijk details en start downloads direct vanaf de bank." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,14" />

    <CheckBox Name="EnableRemoteCheckBox" Content="Spotnet Remote inschakelen" FontWeight="SemiBold" Margin="0,4,0,10" Click="EnableRemoteCheckBox_Click" />

    <Border Name="RemoteConfigPanel" BorderBrush="{DynamicResource DialogPanelBackgroundBrush}" BorderThickness="1" Background="{DynamicResource DialogPanelBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,4,0,14">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Server Status:" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" />
          <TextBlock Name="ServerStatusTextBlock" Text="Gestopt" Foreground="LightGray" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Web-Adres:" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" />
          <TextBlock Name="ServerUrlTextBlock" Text="http://127.0.0.1:8770" Foreground="{DynamicResource HighlightBrush}" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Name="OpenBrowserButton" Content="Open in Browser" Margin="14,0,0,0" Padding="8,2" Click="OpenBrowserButton_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Poort:" Width="120" VerticalAlignment="Center" />
          <TextBox Name="PortTextBox" Text="8770" Width="70" VerticalAlignment="Center" LostFocus="PortTextBox_LostFocus" />
        </StackPanel>

        <CheckBox Name="AllowLanCheckBox" Content="Toegang toestaan vanaf lokaal netwerk (Wi-Fi)" Margin="0,4,0,8" Click="AllowLanCheckBox_Click" />

        <CheckBox Name="RequireAuthCheckBox" Content="Authenticatie vereisen (aanbevolen bij port forwarding)" FontWeight="SemiBold" IsChecked="True" Margin="0,2,0,4" Click="RequireAuthCheckBox_Click" />

        <Border Name="AuthCredentialsPanel" BorderBrush="{DynamicResource DialogPanelBackgroundBrush}" BorderThickness="1" Background="{DynamicResource DialogBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,2,0,8">
          <StackPanel Orientation="Vertical">
            <TextBlock Text="🛡️ Aanbevolen bij port forwarding: Beschermt Spotnet tegen toegang door onbevoegden vanaf internet. Zonder authenticatie kan iedereen met je IP-adres spots inzien en downloads starten." TextWrapping="Wrap" FontSize="11" Opacity="0.85" Margin="0,0,0,8" />

            <TextBlock Name="AuthPasswordHintTextBlock" Margin="0,0,0,8" />
            <Button Name="ChangePasswordButton" Content="Wachtwoord instellen…" HorizontalAlignment="Left" Padding="10,4" Click="ChangePasswordButton_Click" />
          </StackPanel>
        </Border>

        <TextBlock Name="NoAuthWarningTextBlock" Text="⚠️ Waarschuwing: Authenticatie staat uit. Iedereen met toegang tot je netwerk of openstaande poort heeft direct toegang!" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <CheckBox Name="KeepAwakeCheckBox" Content="Houd computer wakker (voorkomt slaapstand zolang Remote actief is)" Margin="0,2,0,10" Click="KeepAwakeCheckBox_Click" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Name="PairDeviceButton" Content="📱 Koppel Nieuw Mobiel Apparaat (PIN / QR)..." FontWeight="Bold" Padding="12,6" Click="PairDeviceButton_Click" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="Gekoppelde Mobiele Apparaten" FontWeight="SemiBold" Margin="0,8,0,6" />
    <ListBox Name="PairedDevicesListBox" Height="140" BorderThickness="1" Background="{DynamicResource DialogBackgroundBrush}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,2">
            <Button Content="Intrekken" DockPanel.Dock="Right" Padding="8,2" Margin="10,0,0,0" Click="RevokeDevice_Click" Tag="{Binding Id}" />
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" />
              <TextBlock Opacity="0.7" FontSize="11">
                <Run Text="Gekoppeld: " />
                <Run Text="{Binding PairedAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" />
                <Run Text=" &bull; Laatst actief: " />
                <Run Text="{Binding LastSeenAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" />
                <Run Text=" (" />
                <Run Text="{Binding IpAddress}" />
                <Run Text=")" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Name="RevokeAllButton" Content="Alle apparaten ontkoppelen" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="8,3" Click="RevokeAllButton_Click" />
  </StackPanel>
</UserControl>
