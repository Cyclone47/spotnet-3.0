          <Label Content="{x:Static p:Words.ShutdownDialogShutdownNow}" Margin="25,0,0,0" />
        </Grid>
      </Button>
      <Button Name="CancelButton" Grid.Column="1" Margin="10,10,10,5" Content="{x:Static p:Words.ShutdownDialogShutdownCancel}" HorizontalAlignment="Right" Height="40" Width="150" IsEnabled="True" TabIndex="0" Click="CancelButton_Click" />
    </Grid>
  </Grid>
</metro:MetroWindow>