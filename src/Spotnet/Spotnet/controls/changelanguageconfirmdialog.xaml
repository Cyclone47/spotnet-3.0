<metro:MetroWindow x:Class="Spotnet.Controls.ChangeLanguageConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.LanguageChange}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" Margin="10,5,10,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Label Name="RetentionLabel" Grid.Row="0" HorizontalAlignment="Left" FontWeight="Bold" Content="{x:Static p:Words.LanguageRestartForSettingTakesEffect}" Margin="10,0,0,0" />
        <DockPanel Grid.Row="1" HorizontalAlignment="Center">
          <Button Name="ConnectButton" Content="{x:Static p:Words.RestartNow}" TabIndex="3" Width="120" IsDefault="True" Margin="10,10,10,0" Click="RestartNow_Click" />
          <Button Name="CancelButton" Width="120" IsEnabled="True" Content="{x:Static p:Words.RestartLater}" TabIndex="4" Margin="10,10,10,0" Click="RestartLater_Click" />
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</metro:MetroWindow>