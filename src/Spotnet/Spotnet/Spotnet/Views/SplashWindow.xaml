<Window x:Class="Spotnet.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="720" Height="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/ImagesInternal/spotnet.ico">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Layer 1: Ambient deep-dark backing glow behind the spotlight logo (prevents any see-through washed-out look) -->
        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Radial dark backing vignette -->
            <Ellipse Width="580" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#F0050E1A" Offset="0"/>
                        <GradientStop Color="#D8050E1A" Offset="0.55"/>
                        <GradientStop Color="#80050E1A" Offset="0.8"/>
                        <GradientStop Color="#00050E1A" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="35"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Floating spotlight logo with strong drop shadow -->
            <Image Source="/Resources/ImagesInternal/splashlogo.png"
                   Stretch="Uniform"
                   MaxHeight="320"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.95"/>
                </Image.Effect>
            </Image>
        </Grid>

        <!-- Layer 2: Floating frosted dark pill container for the status text & progress bar -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                CornerRadius="16"
                Background="#F0071322"
                BorderBrush="#3300D4FF"
                BorderThickness="1"
                Padding="24,10,24,9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#000000" Opacity="0.85"/>
            </Border.Effect>

            <StackPanel Width="420" HorizontalAlignment="Center">
                <!-- Localized status text -->
                <TextBlock x:Name="StatusText"
                           Text="Opstarten..."
                           Foreground="#FFFFFFFF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,7">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Sleek progress capsule -->
                <Border Height="6"
                        CornerRadius="3"
                        Background="#44000000"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Left"
                            Height="6"
                            Width="0"
                            CornerRadius="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0088FF" Offset="0"/>
                                <GradientStop Color="#FF00E5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Version tag -->
                <TextBlock x:Name="VersionText"
                           Text="v3.0.0.0"
                           Foreground="#77FFFFFF"
                           FontSize="10"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Right"
                           Margin="0,4,2,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
