<UserControl x:Class="Spotnet.Downloader.Controls.DownloadTotalsGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Spotnet.Downloader.Controls;assembly=Spotnet">
  <DataGrid Name="DownloadsTotal" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Focusable="False" GridLinesVisibility="None" Height="Auto" Style="{DynamicResource TotalGridStyle}" HeadersVisibility="None">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="TotalCellStyle" TargetType="{x:Type DataGridCell}">
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Margin" Value="0,1,0,0" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Background" Value="{DynamicResource NoticeBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource NoticeForegroundBrush}" />
        </Style>
        <Style x:Key="TotalRowStyle" TargetType="{x:Type DataGridRow}">
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="BorderThickness" Value="0,1,0,0" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush2}" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Background" Value="{DynamicResource NoticeBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource NoticeForegroundBrush}" />
          <Setter Property="Height" Value="Auto" />
          <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="TotalGridStyle" TargetType="{x:Type DataGrid}">
          <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
          <Setter Property="DataGrid.HorizontalScrollBarVisibility" Value="Disabled" />
          <Setter Property="DataGrid.VerticalScrollBarVisibility" Value="Disabled" />
          <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
          <Setter Property="DataGrid.RowStyle" Value="{StaticResource TotalRowStyle}" />
          <Setter Property="DataGrid.CellStyle" Value="{StaticResource TotalCellStyle}" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <DataGrid.Columns>
      <DataGridTextColumn />
      <DataGridTextColumn />
      <DataGridTemplateColumn>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <ProgressBar Margin="2" Minimum="0" Maximum="100" Value="{Binding Path=PercInt, Mode=OneWay}" Visibility="{Binding Path=ProgressBarVisibility, Mode=OneWay}" Opacity="{Binding Path=Opacity, Mode=OneWay}" ToolTip="{Binding Path=Tooltip, Mode=OneWay}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding Path=Speed, Mode=OneWay}" />
      <DataGridTextColumn Binding="{Binding Path=Status, Mode=OneWay}" />
      <DataGridTemplateColumn>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <TextBlock HorizontalAlignment="Right" Margin="3,0,5,0" Text="{Binding Path=Size, Mode=OneWay}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <TextBlock HorizontalAlignment="Right" Margin="3,0,10,0" Text="{Binding Path=Time, Mode=OneWay}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding Path=Added, Mode=OneWay}" />
      <DataGridTextColumn Binding="{Binding Path=Finished, Mode=OneWay}" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
