<UserControl x:Class="Spotnet.Downloader.Controls.DownloadsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:properties="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:controls1="clr-namespace:Spotnet.Downloader.Controls" xmlns:player="clr-namespace:Spotnet.Downloader.Controls.Player" FontSize="{DynamicResource NormalFontSize}">
  <Grid>
    <DockPanel Name="Dock" Height="Auto" Width="Auto" HorizontalAlignment="Stretch" ClipToBounds="False" LastChildFill="True">
      <Panel.Background>
        <ImageBrush ImageSource="/Resources\ImagesInternal\spotsbg.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,150,150" />
      </Panel.Background>
      <controls:WarningTip DockPanel.Dock="Top" Text="{x:Static properties:Words.DbIsNotUpToDateSoSpeedCanBeLowWarning}" Focusable="False" Margin="0,1,0,2" Visibility="{Binding SpotsDbIsNotUpToDateSoSpeedCanBeLowWarningVisibility, Mode=TwoWay}" />
      <Grid Name="ParentGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition MinHeight="3" Height="5*" />
        </Grid.RowDefinitions>
        <Grid Name="PlayerControlParent" Row="0" Visibility="Collapsed" Margin="0,0,0,2">
          <player:PlayerControl x:Name="PlayerControlItem" />
        </Grid>
        <GridSplitter Name="PlayerControlRowSplitter" Grid.Row="0" Visibility="Collapsed" Height="2" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" ResizeBehavior="BasedOnAlignment" ResizeDirection="Rows">
          <FrameworkElement.Style>
            <Style>
              <Setter Property="Control.Background" Value="{StaticResource AccentColorBrush3}" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Control.Background" Value="{StaticResource AccentColorBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </GridSplitter>
        <controls1:DownloadsGrid x:Name="DownloadsGrid" Grid.Row="1" Margin="0,0,0,2" />
      </Grid>
    </DockPanel>
    <Grid>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsDownloaderNotAvailable}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFA9A9A9" Opacity=".5" />
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrightColorBrush2}" Text="{x:Static properties:Words.NzbGetNotAvailable}" FontWeight="Bold" />
    </Grid>
  </Grid>
</UserControl>