<metro:MetroWindow x:Class="Spotnet.Downloader.Controls.ChangeDownloadSpeedLimitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.MenuSpeedLimit}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls="clr-namespace:Spotnet.Downloader.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" Margin="10,5,10,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontWeight="Bold" Content="{x:Static p:Words.SpeedLimit}" Margin="10,0,0,0" />
        <Grid Row="0" Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Name="SpeedLimitCheckBox" Grid.Column="0" TabIndex="1" Click="SpeedLimitCheckBox_OnClick" />
          <Border Name="SpeedLimitTextBoxBorder" Grid.Column="1" BorderBrush="#00FFFFFF" BorderThickness="2">
            <TextBox Name="SpeedLimitTextBox" TabIndex="2" ToolTip="{x:Static p:Words.SpeedLimit}" Width="50" GotFocus="SpeedLimit_GotFocus" TextChanged="SpeedLimitTextBox_OnTextChanged" />
          </Border>
        </Grid>
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
          <Button Name="OkButton" Content="{x:Static p:Words.Ok}" TabIndex="3" Width="80" IsDefault="True" IsEnabled="False" Margin="10,10,10,0" Click="OkButton_Click" />
          <Button Name="CancelButton" Width="80" IsEnabled="True" Content="{x:Static p:Words.Cancel}" TabIndex="4" Margin="10,10,10,0" Click="CancelButton_Click" />
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</metro:MetroWindow>