<UserControl x:Class="Spotnet.Downloader.Controls.VolumeSlider" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Spotnet.Downloader.Controls;assembly=Spotnet">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Path}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Stroke" Value="#FFD3D3D3" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}">
            <Setter Property="Stroke" Value="#FFFF6666" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
        <Setter Property="Background" Value="#9942c0fb" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <FrameworkTemplate.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type RepeatButton}" TargetType="{x:Type RepeatButton}">
                    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="{TemplateBinding Control.Background}" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                  <PathGeometry x:Key="Triangle">
                    <PathFigure StartPoint="0,1">
                      <LineSegment Point="1,1" />
                      <LineSegment Point="1,0" />
                      <LineSegment Point="0,1" />
                    </PathFigure>
                  </PathGeometry>
                </ResourceDictionary>
              </FrameworkTemplate.Resources>
              <Grid>
                <Grid>
                  <UIElement.OpacityMask>
                    <DrawingBrush>
                      <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#FF000000" Geometry="{StaticResource Triangle}" />
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </UIElement.OpacityMask>
                  <Track Name="PART_Track" Value="{TemplateBinding RangeBase.Value}">
                    <Track.Thumb>
                      <Thumb Width="10" Background="{TemplateBinding Control.Background}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Background="{TemplateBinding Control.Background}" />
                          </ControlTemplate>
                        </Control.Template>
                      </Thumb>
                    </Track.Thumb>
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Background="{TemplateBinding Control.Background}" Command="Slider.DecreaseLarge" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Background="#00FFFFFF" Command="Slider.IncreaseLarge" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
                <Path Stretch="Fill" Stroke="#FA737373" StrokeThickness="1" Data="{StaticResource Triangle}" Style="{StaticResource VolumeSliderStyle}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Name="MuteGrid" Width="24" Background="#00FFFFFF">
      <TextBlock Name="VolumeMute" HorizontalAlignment="Left" Style="{StaticResource FontAwesomePlayer}" Margin="4,0,0,0" Text="{Binding VolumeIcon}" />
    </Border>
    <Slider x:Name="VolumeWithMuteSlider" x:FieldModifier="public" Maximum="200" SmallChange="1" LargeChange="5" Grid.Column="1" />
  </Grid>
</UserControl>