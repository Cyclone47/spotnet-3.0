<metro:MetroWindow x:Class="Spotnet.Downloader.Controls.RemoveFilesFromTheDiskDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="NzbGet" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="500" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" WindowTitleBrush="{DynamicResource WindowTitleColorBrush}" TitleForeground="{DynamicResource WindowTitleForegroundBrush}" NonActiveWindowTitleBrush="{DynamicResource NonActiveWindowTitleBrush}" xmlns:controls1="clr-namespace:Spotnet.Downloader.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}" Background="{DynamicResource DialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Label Grid.Row="0" Content="{x:Static p:Words.RemoveFilesDialogQuestion}" Margin="10,20,10,10" />
    <CheckBox Name="DoNotShowCheckbox" Grid.Row="1" TabIndex="0" Margin="10,5">
      <TextBlock Text="{x:Static p:Words.RemoveFilesDialogCheckbox}" TextWrapping="Wrap" FontSize="{DynamicResource ContentFontSize}" />
    </CheckBox>
    <Grid Row="2" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button Name="YesButton" Grid.Column="0" Margin="5" Content="{x:Static p:Words.YesWord}" Height="30" Width="124" HorizontalAlignment="Left" IsDefault="False" TabIndex="1" Click="YesButton_Click" />
      <Button Name="NoButton" Grid.Column="1" Margin="5" Content="{x:Static p:Words.NoWord}" Height="30" Width="124" HorizontalAlignment="Center" IsDefault="True" TabIndex="2" Click="NoButton_Click" />
      <Button Name="CancelButton" Grid.Column="2" Margin="5" Content="{x:Static p:Words.Cancel}" Height="30" Width="124" HorizontalAlignment="Right" TabIndex="3" Click="CancelButton_Click" />
    </Grid>
  </Grid>
</metro:MetroWindow>