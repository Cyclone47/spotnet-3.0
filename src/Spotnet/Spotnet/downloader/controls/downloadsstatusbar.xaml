<UserControl x:Class="Spotnet.Downloader.Controls.DownloadsStatusBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Spotnet.Downloader.Controls" xmlns:p="clr-namespace:Spotnet.Properties" DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Rectangle Width="1">
                <Shape.Fill>
                  <SolidColorBrush Color="{DynamicResource BorderMediumColor}" />
                </Shape.Fill>
              </Rectangle>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
    <TextBlock Text="{x:Static p:Words.SpeedLimitClear}" />
    <TextBlock Text=":  " />
    <TextBlock Text="{Binding SpeedLimitValue}" />
    <Canvas Margin="0,0,12,0">
      <Polygon Stroke="{DynamicResource BlackBrush}" StrokeThickness="0" Fill="{DynamicResource BlackBrush}" Points="4,5 8,11 12,5" />
    </Canvas>
    <Separator Margin="8,0" Style="{StaticResource SeparatorStyle}" />
    <StackPanel Orientation="Horizontal" ToolTip="{Binding SpaceTooltip}">
      <TextBlock Text="{x:Static p:Words.Space}" />
      <TextBlock Text=":  " />
      <TextBlock Text="{Binding Space}" />
    </StackPanel>
  </DockPanel>
</UserControl>