<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(SpotnetTrialFramework)' != ''">$(SpotnetTrialFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>11.0</LangVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Vervangt de kale <Reference>-regels in .NET Framework-stijl: die resolveden niet
         (MSB3245/MSB3243) en MSBuild koos zelf een alternatief. De overige assemblies
         (Microsoft.VisualBasic, System.Configuration, Microsoft.CSharp,
         System.IO.Compression) zitten in de shared framework van .NET 10. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Must match the version the app uses, so the DAL tests exercise the real engine. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="GTranslate" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spotnet.Enc\Spotnet.Enc.csproj" />
    <ProjectReference Include="..\Spotnet\Spotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../tools/Spotnet.SetupHelper/ProfileMigration.cs" Link="Setup/ProfileMigration.cs" />
    <Compile Include="../../../tools/Spotnet.SetupHelper/LegacyDiscovery.cs" Link="Setup/LegacyDiscovery.cs" />
    <Compile Include="../../../tools/Spotnet.SetupHelper/GracefulShutdown.cs" Link="Setup/GracefulShutdown.cs" />
    <Compile Include="../../../tools/Spotnet.SetupHelper/ShortcutManager.cs" Link="Setup/ShortcutManager.cs" />
  </ItemGroup>


</Project>
