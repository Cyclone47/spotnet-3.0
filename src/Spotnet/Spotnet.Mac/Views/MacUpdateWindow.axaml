<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spotnet.Mac.Views.MacUpdateWindow"
        Title="Spotnet bijwerken"
        Width="560"
        Height="440"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource AppWindowBackground}">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="28">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding VersionText}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppTextBrush}"/>
        <TextBlock Text="{Binding CurrentVersionText}"
                   FontSize="12"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
      </StackPanel>
      <Border Grid.Column="1"
              Background="{Binding ReleaseTypeBrush}"
              CornerRadius="5"
              Padding="10,5"
              VerticalAlignment="Top">
        <TextBlock Text="{Binding ReleaseTypeText}"
                   Foreground="White"
                   FontSize="12"
                   FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource AppGridBackground}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <Grid ColumnDefinitions="Auto,12,*,12,Auto">
        <TextBlock Text="Nieuwe versie"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2"
                   Text="Een nieuwe macOS-versie van Spotnet staat klaar."
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
        <TextBlock Grid.Column="4"
                   Text="{Binding SizeText}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="10"/>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
        <TextBlock Text="{Binding ProgressText}"
                   FontSize="12"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding SpeedText}"
                   FontSize="12"
                   Margin="16,0,0,0"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
        <TextBlock Grid.Column="2"
                   Text="{Binding Status}"
                   FontSize="12"
                   Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
      </Grid>
    </Grid>

    <Border Grid.Row="3"
            Background="{DynamicResource AppGridBackground}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,12,0,0"
            IsVisible="{Binding HasChangelog}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="Wat is er nieuw?" FontWeight="SemiBold"/>
          <TextBlock Text="Bekijk de release notes en wijzigingen van deze versie."
                     FontSize="12"
                     Foreground="{DynamicResource AppMutedTextBrush}"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Changelog openen"
                Command="{Binding OpenChangelogCommand}"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Background="{DynamicResource AppGridBackground}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Veilig bijgewerkt" FontWeight="SemiBold"/>
        <TextBlock Text="De download wordt gecontroleerd op bestandsgrootte en SHA-256 voordat Spotnet wordt vervangen."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
      <Button Grid.Column="0"
              Content="Overslaan"
              Command="{Binding SkipCommand}"
              IsVisible="{Binding !IsDownloading}"/>
      <Border Grid.Column="1"/>
      <Button Grid.Column="2"
              Content="Downloaden"
              Command="{Binding DownloadCommand}"
              IsVisible="{Binding !IsDownloaded}"/>
      <Button Grid.Column="2"
              Content="Nu installeren"
              Command="{Binding InstallCommand}"
              IsVisible="{Binding IsDownloaded}"
              Classes="accent"/>
      <Button Grid.Column="3"
              Content="Sluiten"
              Click="OnCloseClick"
              IsVisible="{Binding CanClose}"/>
    </Grid>
  </Grid>
</Window>
