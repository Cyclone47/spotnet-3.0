<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spotnet.Mac.ViewModels"
        xmlns:models="using:Spotnet.Mac.Models"
        x:Class="Spotnet.Mac.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Spotnet - Instellingen"
        Width="520" Height="660"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Instellingen" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Wachtwoorden worden veilig versleuteld in de macOS Sleutelhanger (Keychain)."
                       FontSize="12" Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
        </StackPanel>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Weergavestijl &amp; Thema:" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding ThemeList}"
                          SelectedItem="{Binding SelectedTheme}"
                          HorizontalAlignment="Stretch"/>
                <Separator Margin="0,4"/>

                <TextBlock Text="Snelle Provider Keuze:" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding ProviderList}"
                          SelectedItem="{Binding SelectedProviderItem}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ProviderItem">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Serveradres:" FontWeight="Medium"/>
                <TextBox Text="{Binding Server}" Watermark="bijv. news.eweka.nl"/>

                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Poort:" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Verbindingen:" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding Connections}" Minimum="1" Maximum="100" FormatString="0"/>
                    </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding Ssl}" Content="SSL / TLS versleuteling gebruiken (Aanbevolen, poort 563)"/>

                <CheckBox IsChecked="{Binding AllowInvalidServerCertificate}"
                          IsVisible="{Binding Ssl}"
                          Content="Ongeldig servercertificaat toestaan"
                          ToolTip.Tip="Alleen inschakelen als je provider een zelfondertekend certificaat gebruikt. Het haalt de bescherming weg tegen een andere machine die zich voordoet als de server."/>

                <CheckBox IsChecked="{Binding UseSocksProxy}"
                          Content="Via SOCKS5-proxy verbinden"
                          ToolTip.Tip="Al het nieuwsverkeer loopt via de proxy. TLS wordt daarna opgezet naar de newsserver zelf, dus de proxy ziet alleen versleuteld verkeer."/>

                <Grid ColumnDefinitions="*,8,90" IsVisible="{Binding UseSocksProxy}">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Proxy host:" FontWeight="Medium"/>
                    <TextBox Text="{Binding SocksProxyHost}" Watermark="127.0.0.1"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Poort:" FontWeight="Medium"/>
                    <TextBox Text="{Binding SocksProxyPort}"/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding UseSocksProxy}">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Proxy gebruikersnaam:" FontWeight="Medium"/>
                    <TextBox Text="{Binding SocksProxyUsername}" Watermark="optioneel"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Proxy wachtwoord (Keychain):" FontWeight="Medium"/>
                    <TextBox Text="{Binding SocksProxyPassword}" PasswordChar="•" Watermark="optioneel"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Gebruikersnaam:" FontWeight="Medium"/>
                <TextBox Text="{Binding Username}" Watermark="Usenet gebruikersnaam"/>

                <TextBlock Text="Wachtwoord (Apple Keychain):" FontWeight="Medium"/>
                <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Usenet wachtwoord"/>

                <Separator Margin="0,4"/>
                <TextBlock Text="Download Instellingen" FontSize="14" FontWeight="SemiBold"/>

                <TextBlock Text="Downloadknop actie:" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding DownloadModeList}"
                          SelectedItem="{Binding SelectedDownloadMode}"
                          HorizontalAlignment="Stretch"/>

                <!-- Externe NZBget (Windows: settingsforadvanceddownload) -->
                <StackPanel IsVisible="{Binding IsExternalNzbGet}" Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Gebruik externe NZBget" FontWeight="Medium"/>
                    <TextBlock Text="IP-adres:"/>
                    <TextBox Text="{Binding NzbGetControlIP}" Watermark="127.0.0.1"/>
                    <TextBlock Text="Poort:"/>
                    <TextBox Text="{Binding NzbGetControlPort}" Watermark="6789"/>
                    <TextBlock Text="Gebruikersnaam:"/>
                    <TextBox Text="{Binding NzbGetControlUsername}"/>
                    <TextBlock Text="Wachtwoord:"/>
                    <TextBox Text="{Binding NzbGetControlPassword}" PasswordChar="•"/>
                </StackPanel>

                <TextBlock Text="Downloadmap:" FontWeight="Medium"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DownloadFolder}" Watermark="Pad naar downloadmap"/>
                    <Button Grid.Column="2" Content="Bladeren..." Command="{Binding PickDownloadFolderCommand}"/>
                </Grid>

                <TextBlock Text="Aantal downloadverbindingen:" FontWeight="Medium"/>
                <NumericUpDown Value="{Binding MaxDownloadConnections}" Minimum="1" Maximum="32" FormatString="0"/>

                <CheckBox IsChecked="{Binding SpeedLimitEnabled}" Content="Snelheidslimiet (KB/s)"/>
                <NumericUpDown Value="{Binding SpeedLimit}" IsEnabled="{Binding IsSpeedLimitInputEnabled}"
                               Minimum="50" Maximum="199999" FormatString="0"
                               ToolTip.Tip="Maximale downloadsnelheid in kilobyte per seconde (50 t/m 199999)"/>

                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Aantal pogingen per segment:" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding DownloaderRetries}" Minimum="1" Maximum="100" FormatString="0"
                                       ToolTip.Tip="Hoe vaak een mislukt segment opnieuw wordt geprobeerd"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Tijd tussen pogingen (sec):" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding DownloaderRetryIntervalSec}" Minimum="1" Maximum="3600" FormatString="0"
                                       ToolTip.Tip="Seconden tussen twee pogingen van hetzelfde segment"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Verbinding time-out (ms):" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding ConnectionTimeout}" Minimum="1000" Maximum="300000" FormatString="0"
                                       ToolTip.Tip="Milliseconden om verbinding te maken met de newsserver"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Data time-out (ms):" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding DataReceivingTimeout}" Minimum="5000" Maximum="600000" FormatString="0"
                                       ToolTip.Tip="Milliseconden zonder data waarna de verbinding wordt verbroken"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <CheckBox IsChecked="{Binding IsCachingEnabled}"
                                  Content="Gebruik cache-servers (indien beschikbaar)"
                                  ToolTip.Tip="Maak gebruik van de cacheservers van je provider als die die biedt"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Cachegrootte (MB):" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding DownloaderCacheSizeMb}" Minimum="1" Maximum="4096" FormatString="0"
                                       ToolTip.Tip="Buffer die per download wordt vastgehouden (standaard 20 MB)"/>
                    </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding DownloaderSchedule}"
                          Content="Stel tijdsinterval voor het downloaden"
                          ToolTip.Tip="Downloads zijn alleen actief binnen het opgegeven tijdsvenster"/>

                <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding DownloaderSchedule}">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Starttijd (uu:mm):" FontWeight="Medium"/>
                        <TextBox Text="{Binding DownloaderStartTime}" Watermark="22:00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Eindtijd (uu:mm):" FontWeight="Medium"/>
                        <TextBox Text="{Binding DownloaderEndTime}" Watermark="06:00"/>
                    </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding RemovePar2FilesAfterDownload}"
                          Content="Par2-bestanden verwijderen na download"
                          ToolTip.Tip="Herstelbestanden (par2) worden na een geslaagde download van de schijf verwijderd"/>

                <TextBlock Text="Bestanden verwijderen van de schijf bij download verwijdering" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding RemoveFilesModeList}"
                          SelectedItem="{Binding SelectedRemoveFilesMode}"
                          HorizontalAlignment="Stretch"/>

                <CheckBox IsChecked="{Binding ShutdownPcAfterDownloads}"
                          Content="Sluit mijn pc nadat alle downloads zijn voltooid"
                          ToolTip.Tip="Na de laatste download verschijnt een venster dat na 60 seconden de computer afsluit, tenzij geannuleerd"/>

                <Separator Margin="0,4"/>
                <TextBlock Text="Database &amp; Synchronisatie" FontSize="14" FontWeight="SemiBold"/>

                <TextBlock Text="Eerste synchronisatie bereik:" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding InitialFetchRangeList}"
                          SelectedItem="{Binding SelectedInitialFetchRange}"
                          HorizontalAlignment="Stretch"/>

                <CheckBox IsChecked="{Binding DbAutoUpdateEnabled}"
                          Content="Database automatisch bijwerken"
                          ToolTip.Tip="Nieuwe spots periodiek op de achtergrond ophalen"/>

                <Grid ColumnDefinitions="Auto,8,80,*" Margin="24,0,0,0" IsVisible="{Binding DbAutoUpdateEnabled}">
                    <TextBlock Grid.Column="0" Text="Interval (minuten):" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding DbAutoUpdateIntervalMin}" Minimum="1" Maximum="1440" FormatString="0"/>
                </Grid>

                <CheckBox IsChecked="{Binding RetentionEnabled}"
                          Content="Retentie (dagen)"
                          ToolTip.Tip="Spots ouder dan het opgegeven aantal dagen automatisch verwijderen"/>

                <Grid ColumnDefinitions="Auto,8,80,*" Margin="24,0,0,0" IsVisible="{Binding RetentionEnabled}">
                    <TextBlock Grid.Column="0" Text="Aantal dagen:" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Retention}" Minimum="1" Maximum="9999" FormatString="0"/>
                </Grid>

                <CheckBox IsChecked="{Binding CheckSignatures}"
                          Content="Handtekeningen controleren (RSA)"
                          ToolTip.Tip="Controleer cryptografische handtekeningen van spots (vertrouwensmodel)"/>

                <Grid ColumnDefinitions="Auto,8,120,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="Spot verbergen bij aantal spam meldingen:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SpamReportsThresholdList}"
                              SelectedItem="{Binding SelectedSpamReportsThreshold}"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <CheckBox IsChecked="{Binding HideBlacklistedSpots}"
                          Content="Spots van zwarte lijst gebruikers niet tonen"
                          ToolTip.Tip="Verberg spots waarvan de afzender of de spot zelf op de zwarte lijst staat"/>

                <CheckBox IsChecked="{Binding ShowTrustedOnlyMode}"
                          Content="Toon standaard alleen de spots van witte lijst en vertrouwde afzenders"
                          ToolTip.Tip="Verberg spots van niet-geverifieerde en onbetrouwbare afzenders"/>

                <CheckBox IsChecked="{Binding ShowEroticaInSearchResults}"
                          Content="Toon erotiek in de zoekresultaten"
                          ToolTip.Tip="Neem spots uit categorie 9 (Erotiek) mee in zoekresultaten"/>

                <TextBlock Text="Kleurgebruik:" FontWeight="Medium"/>
                <CheckBox IsChecked="{Binding ColoringSpots}" Margin="24,0,0,0"
                          Content="Gekleurde categoriestreep in de spotlijst"
                          ToolTip.Tip="Windows' ColoringSpots: de kleurstreep v\u00f3\u00f3r het formaat in elke spotrij"/>
                <CheckBox IsChecked="{Binding ColoringFilters}" Margin="24,0,0,0"
                          Content="Gekleurde stippen in de filterboom"
                          ToolTip.Tip="Windows' ColoringFilters: de kleurstip achter filters met een hoofdcategorie"/>
                <CheckBox IsChecked="{Binding SpotImdbShow}" Margin="24,0,0,0"
                          Content="IMDb-paneel automatisch openklappen (Films, Series &amp; Muziek)"
                          ToolTip.Tip="Windows' SpotImdbShow: opent het IMDb- of Links &amp; iTunes-paneel bij elke spot"/>

                <TextBlock Text="Database onderhoud &amp; optimalisatie:" FontWeight="Medium"/>
                <Button Content="Database controleren &amp; repareren"
                        Command="{Binding QuickRepairCommand}"
                        HorizontalAlignment="Left"/>

                <Separator Margin="0,4"/>
                <TextBlock Text="Systeem &amp; Meldingen" FontSize="14" FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="*,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding ShowDesktopNotifications}"
                              Content="Bureaubladmeldingen tonen bij voltooide downloads"/>
                    <Button Grid.Column="1" Content="Test melding"
                            Command="{Binding TestNotificationCommand}"
                            Classes="LinkButton"/>
                </Grid>

                <CheckBox IsChecked="{Binding ExternalBrowser}"
                          Content="Weblinks in spots openen in standaardbrowser"/>

                <Grid ColumnDefinitions="Auto,8,200,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="Afzender bijnaam (alias):" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Nickname}" MaxLength="30" Watermark="Spotter"/>
                </Grid>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontWeight="Medium"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding !IsTesting}"
                    Content="Test Verbinding"/>

            <Button Grid.Column="2"
                    Click="OnCancelClick"
                    Content="Annuleren"/>

            <Button Grid.Column="4"
                    Classes="accent"
                    Command="{Binding SaveCommand}"
                    Content="Opslaan"/>
        </Grid>
    </Grid>
</Window>
