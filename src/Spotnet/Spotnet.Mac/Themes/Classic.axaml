<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Classic. Values are taken from the Windows client's style/classiclight.xaml
       (the original #327ECA blue tints) so the two clients render the same palette;
       the comments name the Windows key each brush comes from. -->

  <!-- Window & chrome -->
  <LinearGradientBrush x:Key="AppWindowBackground" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0"    Color="#FFFEFEFF"/> <!-- AccentColor5Background -->
    <GradientStop Offset="0.20" Color="#FFEFF7FF"/> <!-- AccentColor4Background -->
    <GradientStop Offset="0.90" Color="#FFEFF7FF"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AppMenuBackground"     Color="#FFFFFFFF"/> <!-- SpotnetMenuBackground -->
  <SolidColorBrush x:Key="AppMenuForeground"     Color="#FF172B40"/> <!-- SpotnetMenuForeground -->
  <SolidColorBrush x:Key="AppBorderBrush"        Color="#FF9AAABD"/> <!-- SpotnetMenuBorder -->
  <SolidColorBrush x:Key="AppSidebarBackground"  Color="#FFE5F0FE"/> <!-- NotSelectedBackground -->

  <!-- Accent -->
  <SolidColorBrush x:Key="AppAccentBrush"      Color="#BB327ECA"/> <!-- AccentColor -->
  <SolidColorBrush x:Key="AppAccentForeground" Color="#FFFFFFFF"/> <!-- IdealForegroundColor -->
  <SolidColorBrush x:Key="AppAccentSoftBrush"  Color="#55327ECA"/> <!-- AccentColor3 -->

  <!-- Text -->
  <SolidColorBrush x:Key="AppTextBrush"      Color="#FF111827"/> <!-- SpotRowForegroundBrush -->
  <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF595959"/> <!-- SpotRowMutedBrush -->

  <!-- Filter tree: Classic keeps the tint-and-dark-text pairing -->
  <SolidColorBrush x:Key="AppTreeSelectedBackground" Color="#55327ECA"/>
  <SolidColorBrush x:Key="AppTreeSelectedForeground" Color="#FF000000"/>
  <SolidColorBrush x:Key="AppTreeHoverBackground"    Color="#33327ECA"/>
  <SolidColorBrush x:Key="AppTreeHoverForeground"    Color="#FF000000"/>
  <SolidColorBrush x:Key="AppCountBadgeBackground"   Color="#FFCAE5FF"/> <!-- AccentColor3Background -->

  <!-- Spot list -->
  <SolidColorBrush x:Key="AppGridBackground"          Color="#FFFFFFFF"/> <!-- WhiteColorBrush -->
  <SolidColorBrush x:Key="AppRowBackground"           Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppRowAlternateBackground"  Color="#FFEFF7FF"/> <!-- AccentColor4BackgroundBrush -->
  <SolidColorBrush x:Key="AppRowSelectedBackground"   Color="#55327ECA"/> <!-- AccentColorBrush3 -->
  <SolidColorBrush x:Key="AppRowHoverBackground"      Color="#33327ECA"/> <!-- AccentColorBrush4 -->
  <SolidColorBrush x:Key="AppHeaderBackground"        Color="#FFF0F0F0"/> <!-- GrayBrush8 -->
  <SolidColorBrush x:Key="AppHeaderForeground"        Color="#FF000000"/> <!-- BlackBrush -->
  <SolidColorBrush x:Key="AppGridLineBrush"           Color="#FFCCCCCC"/> <!-- GrayBrush5 -->

  <!-- "Formaat" pill -->
  <SolidColorBrush x:Key="AppFormatBadgeBackground" Color="#BB327ECA"/>
  <SolidColorBrush x:Key="AppFormatBadgeForeground" Color="#FFFFFFFF"/>
</ResourceDictionary>
