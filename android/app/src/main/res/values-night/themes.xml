        <item name="colorPrimaryVariant">@color/spotnet_navy</item>
        <item name="colorOnPrimary">#0f172a</item>
        <item name="colorSecondary">@color/spotnet_blue_light</item>
        <item name="colorSecondaryVariant">@color/spotnet_navy_dark</item>
        <item name="colorOnSecondary">#0f172a</item>
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/nav_bar_bg</item>
